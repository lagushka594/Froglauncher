<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Минимальный RibbixNews (RibbixNews.exe): вход сотрудника + раздел «Подписки».
    Нужен, пока модуль не встроен в ваше настоящее приложение RibbixNews.
    Адрес backend — в RibbixNews.settings.json рядом с exe (или переменная RIBBIXNEWS_API).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RibbixNews</AssemblyName>
    <RootNamespace>RibbixNews.DevHost</RootNamespace>
    <ApplicationIcon>..\..\assets\out\ui\icon_frog.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RibbixNews.Subscriptions\RibbixNews.Subscriptions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="RibbixNews.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
