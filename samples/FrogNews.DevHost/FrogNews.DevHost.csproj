<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Минимальный FrogNews (FrogNews.exe): вход сотрудника + раздел «Подписки».
    Нужен, пока модуль не встроен в ваше настоящее приложение FrogNews.
    Адрес backend — в FrogNews.settings.json рядом с exe (или переменная FROGNEWS_API).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FrogNews</AssemblyName>
    <RootNamespace>FrogNews.DevHost</RootNamespace>
    <ApplicationIcon>..\..\assets\out\ui\icon_frog.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FrogNews.Subscriptions\FrogNews.Subscriptions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="FrogNews.settings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
