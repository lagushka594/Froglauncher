<Window x:Class="FrogLauncher.Views.CrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrogLauncher — крэш" Width="820" Height="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding [crash_title], Source={StaticResource L}}" Style="{StaticResource H1}"/>
            <TextBlock Text="{Binding [last_lines], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,4,0,8"/>
        </StackPanel>
        <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="LinkBtn" Content="{Binding [open_mclogs], Source={StaticResource L}}" Style="{StaticResource GreenButton}"/>
            <Button x:Name="CopyBtn" Content="Copy" Style="{StaticResource GreenButton}"/>
            <Button x:Name="CloseBtn" Content="{Binding [close], Source={StaticResource L}}" Style="{StaticResource GreenButton}"/>
        </StackPanel>
    </Grid>
</Window>
