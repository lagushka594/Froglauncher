<Window x:Class="FrogLauncher.Views.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrogLauncher" Width="460" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource Card}" Margin="14">
        <StackPanel>
            <TextBlock Text="{Binding [new_instance_title], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding [name], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
            <TextBox x:Name="NameBox"/>

            <TextBlock Text="{Binding [mc_version], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
            <ComboBox x:Name="VersionBox"/>

            <TextBlock Text="{Binding [loader], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
            <ComboBox x:Name="LoaderBox"/>

            <StackPanel x:Name="LoaderVerPanel" Visibility="Collapsed">
                <TextBlock Text="{Binding [loader_version], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                <ComboBox x:Name="LoaderVerBox"/>
            </StackPanel>

            <TextBlock x:Name="HintText" Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CreateBtn" Content="{Binding [create], Source={StaticResource L}}" Style="{StaticResource GreenButton}" Padding="22,8"/>
                <Button x:Name="CancelBtn" Content="{Binding [cancel], Source={StaticResource L}}" Style="{StaticResource GreenButton}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
