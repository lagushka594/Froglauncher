                                                <TextBlock Text="{Binding [priv_status], Source={StaticResource L}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TierName}" Foreground="{Binding TierColor}" FontSize="20" FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding [priv_price_note], Source={StaticResource L}}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding [priv_refresh], Source={StaticResource L}}" Command="{Binding RefreshPrivilegesCommand}" Style="{StaticResource GreenButton}" Margin="12,0,0,0" VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>

                                <!-- карточки привилегий -->
                                <ItemsControl ItemsSource="{Binding Tiers}" Margin="0,12,0,0">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Card}" Width="430" Margin="0,0,12,12" BorderBrush="{Binding Color}" BorderThickness="1.5">
