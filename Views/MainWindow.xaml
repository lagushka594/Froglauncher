                                        <TextBlock Text="{Binding [priv_admin_panel], Source={StaticResource L}}" Style="{StaticResource H1}" Foreground="#FF7A7A"/>
                                        <TextBlock Text="{Binding AdminSummary}" Style="{StaticResource Muted}" Margin="0,4,0,2"/>
                                        <TextBlock Text="{Binding [priv_admin_hint], Source={StaticResource L}}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <ListBox ItemsSource="{Binding AdminGrants}" MaxHeight="260">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TierName}" Foreground="{DynamicResource AccentBrush}"/>
