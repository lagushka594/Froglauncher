                                <WrapPanel>
                                    <Button Content="{Binding [add_mods], Source={StaticResource L}}" Command="{Binding AddModsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,4"/>
                                    <Button Content="{Binding [update_mods], Source={StaticResource L}}" Command="{Binding UpdateModsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,4"/>
                                    <Button Content="{Binding [refresh], Source={StaticResource L}}" Command="{Binding RefreshModsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,4"/>
                                    <Button Content="{Binding [mods], Source={StaticResource L}}" Command="{Binding OpenModsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,4"/>
                                    <Button Content="{Binding [mod_remove], Source={StaticResource L}}" Command="{Binding DeleteModCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,4"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                            <Grid>
                                <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="46" Height="46" Background="#0A1218" CornerRadius="6" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock Text="🧩" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                                        <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding [no_mods], Source={StaticResource L}}" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding HasNoMods, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2">
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10" Visibility="{Binding CanModProfiles, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [priv_profiles], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <ComboBox Width="190" ItemsSource="{Binding ModProfiles}" SelectedItem="{Binding SelectedModProfile}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [priv_apply_profile], Source={StaticResource L}}" Command="{Binding ApplyModProfileCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [delete], Source={StaticResource L}}" Command="{Binding DeleteModProfileCommand}" Style="{StaticResource DangerButton}" Margin="0,0,18,6"/>
                                        <TextBox Width="190" Text="{Binding NewModProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,6" ToolTip="{Binding [priv_profile_new], Source={StaticResource L}}"/>
                                        <Button Content="{Binding [priv_save_profile], Source={StaticResource L}}" Command="{Binding SaveModProfileCommand}" Style="{StaticResource GreenButton}" Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ProgressBar Value="{Binding ProgressValue}" Width="300" Height="38" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- JAVA -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=3}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Java" Style="{StaticResource H1}"/>
                                    <TextBlock Text="{Binding JavaRequirementText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding JavaList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Home}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CompatText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#E5484D"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Compatible}" Value="True"><Setter Property="Foreground" Value="#4CE04B"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding [rescan], Source={StaticResource L}}" Command="{Binding RescanJavaCommand}" Style="{StaticResource GreenButton}"/>
                                <ComboBox Width="90" ItemsSource="{Binding JavaMajors}" SelectedItem="{Binding DownloadJavaMajor}" Margin="12,0,8,0"/>
                                <Button Content="{Binding [download_java], Source={StaticResource L}}" Command="{Binding DownloadJavaCommand}" Style="{StaticResource GreenButton}"/>
                                <ProgressBar Value="{Binding ProgressValue}" Width="240" Height="34" Margin="12,0,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- НАСТРОЙКИ (все переключатели сохраняются сразу) -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=4}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [behavior], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,12"/>
                                        <CheckBox Content="{Binding [hide_on_launch], Source={StaticResource L}}" IsChecked="{Binding HideOnLaunch}" Margin="0,0,0,10" FontSize="14"/>
                                        <CheckBox Content="{Binding [close_instead], Source={StaticResource L}}" IsChecked="{Binding CloseInsteadOfHide}" Margin="56,0,0,10"/>
                                        <CheckBox Content="{Binding [reopen_after], Source={StaticResource L}}" IsChecked="{Binding ReopenAfterExit}" Margin="0,0,0,10"/>
