                    </Grid>

                    <!-- МОДЫ ВЕРСИИ (отдельная вкладка: название + картинка мода) -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=6}">
