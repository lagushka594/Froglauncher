                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [priv_howto_title], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding [priv_howto], Source={StaticResource L}}" TextWrapping="Wrap" Foreground="#D6E6DA" LineHeight="21"/>
                                        <Button Command="{Binding OpenDiscordCommand}" Style="{StaticResource GreenButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Padding="18,9">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Assets/social_discord.png" Width="22" Height="22" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding [discord], Source={StaticResource L}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- мои возможности -->
                                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding HasTier, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [priv_my_perks], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,10"/>

                                        <StackPanel Visibility="{Binding CanBackground, Converter={StaticResource BoolToVis}}" Margin="0,0,0,14">
                                            <TextBlock Text="{Binding [priv_bg], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding [priv_choose], Source={StaticResource L}}" Command="{Binding PickBackgroundCommand}" Style="{StaticResource GreenButton}"/>
                                                <Button Content="{Binding [priv_reset], Source={StaticResource L}}" Command="{Binding ResetBackgroundCommand}" Style="{StaticResource DangerButton}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <CheckBox Content="{Binding [priv_autobackup], Source={StaticResource L}}" IsChecked="{Binding AutoBackupWorlds}" Margin="0,0,0,10"
                                                  Visibility="{Binding CanAutoBackup, Converter={StaticResource BoolToVis}}"/>
                                        <CheckBox Content="{Binding [priv_autoupdate], Source={StaticResource L}}" IsChecked="{Binding AutoUpdateMods}" Margin="0,0,0,10"
                                                  Visibility="{Binding CanAutoUpdateMods, Converter={StaticResource BoolToVis}}"/>
                                        <CheckBox Content="{Binding [priv_fast], Source={StaticResource L}}" IsChecked="{Binding FastDownloads}" Margin="0,0,0,10"
                                                  Visibility="{Binding CanFast, Converter={StaticResource BoolToVis}}"/>
                                        <CheckBox Content="{Binding [priv_beta], Source={StaticResource L}}" IsChecked="{Binding BetaUpdates}" Margin="0,0,0,10"
                                                  Visibility="{Binding CanBeta, Converter={StaticResource BoolToVis}}"/>

                                        <StackPanel Visibility="{Binding CanRpcText, Converter={StaticResource BoolToVis}}" Margin="0,4,0,10">
                                            <TextBlock Text="{Binding [priv_rpc], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding CustomPresence, UpdateSourceTrigger=LostFocus}" MaxLength="60"/>
                                        </StackPanel>

                                        <StackPanel Visibility="{Binding CanStats, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding [priv_stats_title], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding StatsText}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </StackPanel>
