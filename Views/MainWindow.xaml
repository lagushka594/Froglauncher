                                                    <TextBlock Text="{Binding Perks}" TextWrapping="Wrap" Margin="0,10,0,12" Foreground="#D6E6DA" LineHeight="20"/>
                                                    <Grid>
                                                        <Button Content="{Binding [priv_buy], Source={StaticResource L}}" Command="{Binding DataContext.BuyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Id}" Style="{StaticResource GreenButton}" Margin="0" HorizontalAlignment="Left" Padding="28,9"/>
                                                        <TextBlock Text="{Binding [priv_owned], Source={StaticResource L}}" Foreground="{Binding Color}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers><DataTrigger Binding="{Binding Owned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                            </Style></TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

