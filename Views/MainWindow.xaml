<Window x:Class="FrogLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrogLauncher" Width="1140" Height="720" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BgBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStyle="SingleBorderWindow">

    <!-- Кастомный заголовок: системную рамку убираем, но оставляем Aero Snap и ресайз -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <!-- Фон -->
        <Image Source="/Assets/bg.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Rectangle Fill="#B3080E14"/>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <!-- ===== Заголовок ===== -->
            <Grid Grid.Row="0" Background="#CC0A1016">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/avatar.png" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="FrogLauncher" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Muted}" Margin="8,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="MinBtn" Content="—" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource CaptionButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <!-- ===== Боковая панель ===== -->
                <Border Grid.Column="0" Background="#B0090F15" BorderBrush="#1E3A2A" BorderThickness="0,0,1,0" Padding="12">
                    <DockPanel>
                        <Button x:Name="ExitBtn" DockPanel.Dock="Bottom" Style="{StaticResource GreenButton}" Margin="0" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/btn_exit.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding [nav_exit], Source={StaticResource L}}"/>
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <Image Source="/Assets/logo.png" Height="118" Margin="0,2,0,14" RenderOptions.BitmapScalingMode="HighQuality"/>

                            <RadioButton GroupName="nav" Style="{StaticResource NavRadio}" Command="{Binding NavCommand}" CommandParameter="0"
                                         IsChecked="{Binding SelectedTab, Mode=OneWay, Converter={StaticResource IntEq}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" Width="28" FontSize="18"/><TextBlock Text="{Binding [nav_home], Source={StaticResource L}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Style="{StaticResource NavRadio}" Command="{Binding NavCommand}" CommandParameter="1"
                                         IsChecked="{Binding SelectedTab, Mode=OneWay, Converter={StaticResource IntEq}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal"><Image Source="/Assets/icon_version.png" Width="24" Height="24" Margin="0,0,4,0"/><TextBlock Text="{Binding [nav_versions], Source={StaticResource L}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Style="{StaticResource NavRadio}" Command="{Binding NavCommand}" CommandParameter="2"
                                         IsChecked="{Binding SelectedTab, Mode=OneWay, Converter={StaticResource IntEq}, ConverterParameter=2}">
                                <StackPanel Orientation="Horizontal"><Image Source="/Assets/icon_folder.png" Width="24" Height="24" Margin="0,0,4,0"/><TextBlock Text="{Binding [nav_instances], Source={StaticResource L}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Style="{StaticResource NavRadio}" Command="{Binding NavCommand}" CommandParameter="5"
                                         IsChecked="{Binding SelectedTab, Mode=OneWay, Converter={StaticResource IntEq}, ConverterParameter=5}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="🧩" Width="28" FontSize="18"/><TextBlock Text="{Binding [nav_modcat], Source={StaticResource L}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Style="{StaticResource NavRadio}" Command="{Binding NavCommand}" CommandParameter="3"
                                         IsChecked="{Binding SelectedTab, Mode=OneWay, Converter={StaticResource IntEq}, ConverterParameter=3}">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="☕" Width="28" FontSize="18"/><TextBlock Text="{Binding [nav_java], Source={StaticResource L}}"/></StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="nav" Style="{StaticResource NavRadio}" Command="{Binding NavCommand}" CommandParameter="4"
                                         IsChecked="{Binding SelectedTab, Mode=OneWay, Converter={StaticResource IntEq}, ConverterParameter=4}">
                                <StackPanel Orientation="Horizontal"><Image Source="/Assets/btn_settings.png" Width="24" Height="24" Margin="0,0,4,0"/><TextBlock Text="{Binding [nav_settings], Source={StaticResource L}}"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ===== Контент ===== -->
                <Grid Grid.Column="1" Margin="18">

                    <!-- ГЛАВНАЯ -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=0}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Image Source="/Assets/avatar.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountName}" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding AccountTypeText}" Style="{StaticResource Muted}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding [nickname], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,14,0,4"/>
                                    <TextBox Text="{Binding OfflineNick, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="{Binding [login_offline], Source={StaticResource L}}" Command="{Binding LoginOfflineCommand}" Style="{StaticResource GreenButton}"/>
                                        <Button Content="{Binding [login_ms], Source={StaticResource L}}" Command="{Binding LoginMsCommand}" Style="{StaticResource GreenButton}"/>
                                        <Button Content="{Binding [logout], Source={StaticResource L}}" Command="{Binding LogoutCommand}" Style="{StaticResource GreenButton}"
                                                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DeviceMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"
                                               Visibility="{Binding DeviceMessage, Converter={StaticResource NotNullToVis}}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding [instance], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"/>
                                    <TextBlock Text="{Binding InstanceStatusText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                                    <Grid Margin="0,14,0,6" Height="110">
                                        <Button Style="{StaticResource PlayButton}" Command="{Binding PlayCommand}" HorizontalAlignment="Center"
                                                Visibility="{Binding CanPlay, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource DangerButton}" Command="{Binding StopCommand}" Width="230" Height="60" FontSize="22" Margin="0"
                                                Content="{Binding [stop], Source={StaticResource L}}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>

                                    <Grid Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ProgressBar Value="{Binding ProgressValue}" Height="44" VerticalAlignment="Center"/>
                                        <Image Grid.Column="1" Source="/Assets/loader.png" Width="34" Height="34" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.6"/>
                                                    </Storyboard></BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Grid>
                                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <Button Content="{Binding [cancel], Source={StaticResource L}}" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                            Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="84" Height="164" Background="#0A1218" CornerRadius="8" BorderBrush="{DynamicResource AccentDarkBrush}" BorderThickness="1">
                                        <Image Source="{Binding SkinPreview}" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               Visibility="{Binding HasSkin, Converter={StaticResource BoolToVis}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding [skin], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,8"/>
                                        <Button Content="{Binding [pick_skin], Source={StaticResource L}}" Command="{Binding PickSkinCommand}" Style="{StaticResource GreenButton}" HorizontalAlignment="Left"/>
                                        <CheckBox Content="{Binding [slim], Source={StaticResource L}}" IsChecked="{Binding SkinSlim}" Margin="0,10,0,10"/>
                                        <Button Content="{Binding [upload_skin], Source={StaticResource L}}" Command="{Binding UploadSkinCommand}" Style="{StaticResource GreenButton}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                        <TextBlock Text="{Binding [news], Source={StaticResource L}}" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                                        <Button Content="⟳" Command="{Binding RefreshNewsCommand}" Style="{StaticResource GreenButton}" Padding="10,2" Margin="0" HorizontalAlignment="Right" FontSize="16"/>
                                    </Grid>
                                    <ListBox ItemsSource="{Binding News}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Date}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding Short}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#C9DCCF"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding [status], Source={StaticResource L}}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <ItemsControl ItemsSource="{Binding ServerStatuses}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                    <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style><Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#E5484D"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding Ok}" Value="True"><Setter Property="Fill" Value="#4CE04B"/></DataTrigger></Style.Triggers>
                                                        </Style></Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="10" Height="150" Visibility="{Binding ShowGameLog, Converter={StaticResource BoolToVis}}">
                                <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11"/></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ВЕРСИИ -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=1}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/icon_version.png" Width="36" Height="36" Margin="0,0,12,0"/>
                                <ComboBox Width="190" SelectedIndex="{Binding VersionFilter, Mode=TwoWay}" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="{Binding [filter_release], Source={StaticResource L}}"/>
                                    <ComboBoxItem Content="{Binding [filter_snapshot], Source={StaticResource L}}"/>
                                    <ComboBoxItem Content="{Binding [filter_old], Source={StaticResource L}}"/>
                                </ComboBox>
                                <Button Content="{Binding [refresh], Source={StaticResource L}}" Command="{Binding RefreshVersionsCommand}" Style="{StaticResource GreenButton}" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="12,0,12,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [col_version], Source={StaticResource L}}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [col_type], Source={StaticResource L}}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding [col_date], Source={StaticResource L}}" Style="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding [col_size], Source={StaticResource L}}" Style="{StaticResource Muted}"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding FilteredVersions}" SelectedItem="{Binding SelectedVersion}" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="188"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText}" Style="{StaticResource Muted}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Muted}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Muted}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding [loader], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                    <ComboBox Width="150" ItemsSource="{Binding LoaderTypes}" SelectedItem="{Binding SelectedLoader}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Visibility="{Binding NeedsLoaderVersion, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding [loader_version], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                    <ComboBox Width="230" ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding SelectedLoaderVersion}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                    <ProgressBar Value="{Binding ProgressValue}" Width="260" Height="36" Margin="0,0,0,6" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="{Binding [install], Source={StaticResource L}}" Command="{Binding InstallCommand}" Style="{StaticResource GreenButton}" Margin="0" FontSize="15" Padding="26,9"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ИНСТАНСЫ -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=2}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{Binding [new_instance], Source={StaticResource L}}" Command="{Binding NewInstanceCommand}" Style="{StaticResource GreenButton}"/>
                                    <Button Content="{Binding [import], Source={StaticResource L}}" Command="{Binding ImportCommand}" Style="{StaticResource GreenButton}"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="/Assets/icon_folder.png" Width="38" Height="38" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                                    <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding McVersion}"/> • <Run Text="{Binding Loader}"/></TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasInstance, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedInstance.Display}" Style="{StaticResource H1}" Margin="0,0,0,10"/>
                                    <TextBlock Text="{Binding [name], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding SelectedInstance.Name, UpdateSourceTrigger=LostFocus}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding [ram_min], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedInstance.MinRamMb, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding [ram_max], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding SelectedInstance.MaxRamMb, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding [jvm_args], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding SelectedInstance.JvmArgs, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="{Binding [resolution], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="90" Text="{Binding SelectedInstance.Width, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Text="×" Margin="10,6" FontSize="16"/>
                                        <TextBox Width="90" Text="{Binding SelectedInstance.Height, UpdateSourceTrigger=LostFocus}"/>
                                        <CheckBox Content="{Binding [fullscreen], Source={StaticResource L}}" IsChecked="{Binding SelectedInstance.Fullscreen}" Margin="20,0,0,0"/>
                                        <CheckBox Content="{Binding [demo], Source={StaticResource L}}" IsChecked="{Binding SelectedInstance.Demo}" Margin="20,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding [server], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding SelectedInstance.ServerAddress, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="{Binding [java_path], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding SelectedInstance.JavaPath, UpdateSourceTrigger=LostFocus}"/>
                                        <Button Grid.Column="1" Content="{Binding [browse], Source={StaticResource L}}" Command="{Binding BrowseJavaCommand}" Style="{StaticResource GreenButton}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding [pre_cmd], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding SelectedInstance.PreLaunchCommand, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="{Binding [post_cmd], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding SelectedInstance.PostExitCommand, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Text="{Binding [game_folder], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                    <TextBox Text="{Binding SelectedInstance.GameDir, Mode=OneWay}" IsReadOnly="True"/>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Muted}"><Run Text="{Binding [playtime], Source={StaticResource L}, Mode=OneWay}"/>: <Run Text="{Binding SelectedInstance.PlayTimeText, Mode=OneWay}"/></TextBlock>
                                    <TextBlock Text="{Binding ModsText}" Style="{StaticResource Muted}" Margin="0,12,0,3"/>
                                    <Border Background="#0A1218" BorderBrush="{DynamicResource AccentDarkBrush}" BorderThickness="1" CornerRadius="6" Height="140" Padding="4">
                                        <ListBox ItemsSource="{Binding Mods}" SelectedItem="{Binding SelectedMod}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding Enabled}" Content="{Binding Name}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{Binding [add_mods], Source={StaticResource L}}" Command="{Binding AddModsCommand}" Style="{StaticResource GreenButton}"/>
                                        <Button Content="{Binding [mod_remove], Source={StaticResource L}}" Command="{Binding DeleteModCommand}" Style="{StaticResource DangerButton}"/>
                                        <Button Content="{Binding [refresh], Source={StaticResource L}}" Command="{Binding RefreshModsCommand}" Style="{StaticResource GreenButton}"/>
                                    </StackPanel>
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="{Binding [save], Source={StaticResource L}}" Command="{Binding SaveInstanceCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Command="{Binding OpenFolderCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6">
                                            <StackPanel Orientation="Horizontal"><Image Source="/Assets/icon_folder.png" Width="20" Height="20" Margin="0,0,6,0"/><TextBlock Text="{Binding [folder], Source={StaticResource L}}"/></StackPanel>
                                        </Button>
                                        <Button Content="{Binding [mods], Source={StaticResource L}}" Command="{Binding OpenModsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [export], Source={StaticResource L}}" Command="{Binding ExportCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [auto_ram], Source={StaticResource L}}" Command="{Binding AutoRamCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [repair], Source={StaticResource L}}" Command="{Binding RepairCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [clone], Source={StaticResource L}}" Command="{Binding CloneCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [backup], Source={StaticResource L}}" Command="{Binding BackupCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [shortcut], Source={StaticResource L}}" Command="{Binding DesktopShortcutCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [update_mods], Source={StaticResource L}}" Command="{Binding UpdateModsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,6"/>
                                        <Button Content="{Binding [delete], Source={StaticResource L}}" Command="{Binding DeleteInstanceCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>

                    <!-- КАТАЛОГ МОДОВ -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=5}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding [nav_modcat], Source={StaticResource L}}" Style="{StaticResource H1}"/>
                                <TextBlock Text="{Binding ModTarget}" Style="{StaticResource Muted}" Margin="0,3,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="150" ItemsSource="{Binding ModSources}" SelectedItem="{Binding SelectedModSource}" Margin="0,0,10,0"/>
                                    <TextBox Width="400" Text="{Binding ModQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0">
                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchModsCommand}"/></TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="{Binding [search], Source={StaticResource L}}" Command="{Binding SearchModsCommand}" Style="{StaticResource GreenButton}" Padding="22,7"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Content="{Binding [more], Source={StaticResource L}}" Command="{Binding MoreModsCommand}" Style="{StaticResource GreenButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Center" Visibility="{Binding ModHasMore, Converter={StaticResource BoolToVis}}"/>
                                <ListBox ItemsSource="{Binding ModResults}" SelectedItem="{Binding SelectedModResult}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" Background="#0A1218" CornerRadius="6" Margin="0,0,12,0" VerticalAlignment="Top">
                                                    <Image Source="{Binding IconUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Author}" Style="{StaticResource Muted}"/>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxHeight="34" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DownloadsText, StringFormat='⬇ {0}'}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding SourceText}" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ProgressBar Value="{Binding ProgressValue}" Width="300" Height="38" HorizontalAlignment="Left" Margin="0,0,0,4" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ModStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding [install_mod], Source={StaticResource L}}" Command="{Binding InstallModCommand}" Style="{StaticResource GreenButton}" Margin="12,0,0,0" FontSize="15" Padding="26,9"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- JAVA -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=3}">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Java" Style="{StaticResource H1}"/>
                                    <TextBlock Text="{Binding JavaRequirementText}" Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding JavaList}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="{Binding Home}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CompatText}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0">
                                                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Foreground" Value="#E5484D"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Compatible}" Value="True"><Setter Property="Foreground" Value="#4CE04B"/></DataTrigger></Style.Triggers>
                                                    </Style></TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding [rescan], Source={StaticResource L}}" Command="{Binding RescanJavaCommand}" Style="{StaticResource GreenButton}"/>
                                <ComboBox Width="90" ItemsSource="{Binding JavaMajors}" SelectedItem="{Binding DownloadJavaMajor}" Margin="12,0,8,0"/>
                                <Button Content="{Binding [download_java], Source={StaticResource L}}" Command="{Binding DownloadJavaCommand}" Style="{StaticResource GreenButton}"/>
                                <ProgressBar Value="{Binding ProgressValue}" Width="240" Height="34" Margin="12,0,0,0" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- НАСТРОЙКИ -->
                    <Grid Style="{StaticResource ViewGrid}" Visibility="{Binding SelectedTab, Converter={StaticResource IntEq}, ConverterParameter=4}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Поведение -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [behavior], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,10"/>
                                        <CheckBox Content="{Binding [hide_on_launch], Source={StaticResource L}}" IsChecked="{Binding HideOnLaunch}" Margin="0,0,0,8" FontSize="14"/>
                                        <CheckBox Content="{Binding [close_instead], Source={StaticResource L}}" IsChecked="{Binding CloseInsteadOfHide}" Margin="24,0,0,8"/>
                                        <CheckBox Content="{Binding [reopen_after], Source={StaticResource L}}" IsChecked="{Binding ReopenAfterExit}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{Binding [show_log], Source={StaticResource L}}" IsChecked="{Binding ShowGameLog}" Margin="0,0,0,8"/>
                                        <CheckBox Content="{Binding [autostart], Source={StaticResource L}}" IsChecked="{Binding AutoStart}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding [language], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding [theme], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                                <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding [default_ram], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding DefaultMaxRam, UpdateSourceTrigger=LostFocus}" Width="140" HorizontalAlignment="Left"/>
                                        <TextBlock Text="{Binding [game_folder], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding GameRoot, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding [proxy], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="{Binding [apply], Source={StaticResource L}}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource GreenButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="26,8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Инструменты -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [tools], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button Content="{Binding [open_game], Source={StaticResource L}}" Command="{Binding OpenGameFolderCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,8"/>
                                            <Button Content="{Binding [open_logs], Source={StaticResource L}}" Command="{Binding OpenLogsCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,8"/>
                                            <Button Content="{Binding [clear_cache], Source={StaticResource L}}" Command="{Binding ClearCacheCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,8"/>
                                            <Button Content="{Binding [check_updates], Source={StaticResource L}}" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource GreenButton}" Margin="0,0,8,8"/>
                                            <Button Content="{Binding [reset_settings], Source={StaticResource L}}" Command="{Binding ResetSettingsCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                                            <Button Content="{Binding [logout], Source={StaticResource L}}" Command="{Binding LogoutCommand}" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Дополнительно: свои ключи (по умолчанию уже вшиты в лаунчер) -->
                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding [advanced], Source={StaticResource L}}" Style="{StaticResource H1}" Margin="0,0,0,10"/>
                                        <TextBlock Text="{Binding [ms_client], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding MsClientId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding [cf_key], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding CurseForgeKey, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding [news_url], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding NewsUrlOverride, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding [update_repo], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,10,0,3"/>
                                        <TextBox Text="{Binding UpdateRepo, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                </Grid>

                <!-- Сплэш при запуске (panel.png + splash_frog.png + loader.png) -->
                <Grid Grid.ColumnSpan="2" Background="#F2080E14" Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}">
                    <Grid Width="480" Height="204" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Assets/panel.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image Source="/Assets/splash_frog.png" Width="150" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="FrogLauncher" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding [loading], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,4,0,10"/>
                                <Image Source="/Assets/loader.png" Width="38" Height="38" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                                    <Image.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.6"/>
                                            </Storyboard></BeginStoryboard>
                                        </EventTrigger>
                                    </Image.Triggers>
                                </Image>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Первый запуск: вход -->
                <Grid Grid.ColumnSpan="2" Background="#F2080E14" Visibility="{Binding NeedLogin, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource Card}" Width="470" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <Image Source="/Assets/logo.png" Height="120" Margin="0,0,0,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="{Binding [welcome_title], Source={StaticResource L}}" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding [welcome_text], Source={StaticResource L}}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,16"/>
                            <TextBlock Text="{Binding [login_hint], Source={StaticResource L}}" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding OfflineNick, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" FontSize="15">
                                <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding LoginOfflineCommand}"/></TextBox.InputBindings>
                            </TextBox>
                            <Button Content="{Binding [login_offline], Source={StaticResource L}}" Command="{Binding LoginOfflineCommand}" Style="{StaticResource GreenButton}" Margin="0,12,0,0" Padding="14,10"/>
                            <TextBlock Text="— / —" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,10"/>
                            <Button Content="{Binding [login_ms], Source={StaticResource L}}" Command="{Binding LoginMsCommand}" Style="{StaticResource GreenButton}" Margin="0" Padding="14,10"/>
                            <TextBlock Text="{Binding DeviceMessage}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0" TextAlignment="Center"
                                       Visibility="{Binding DeviceMessage, Converter={StaticResource NotNullToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
