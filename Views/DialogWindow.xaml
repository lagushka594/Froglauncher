<Window x:Class="FrogLauncher.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" Height="380" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- рамка и иконка — из ассетов panel_info / warning / success / error -->
        <Image x:Name="Frame" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Grid Margin="40,36,40,46">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Margin="62,2,0,0" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
            <ScrollViewer Grid.Row="1" Margin="0,34,0,10" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Foreground="#E3EEE6" LineHeight="20"/>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkBtn" Style="{StaticResource GreenButton}" Padding="26,8" Margin="0,0,10,0" IsDefault="True"/>
                <Button x:Name="NoBtn" Style="{StaticResource GreenButton}" Padding="22,8" Margin="0" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
