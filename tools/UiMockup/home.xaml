<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:v="clr-namespace:RibbixLauncher.Views;assembly=RibbixLauncher"
      Background="#0B1220">
    <Image Source="pack://application:,,,/RibbixLauncher;component/Assets/main/bg.png" Stretch="UniformToFill" />
    <Rectangle>
        <Rectangle.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#F00B1220" Offset="0" />
                <GradientStop Color="#C00B1220" Offset="0.45" />
                <GradientStop Color="#900B1220" Offset="1" />
            </LinearGradientBrush>
        </Rectangle.Fill>
    </Rectangle>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковое меню -->
        <Border Background="#C0060A16" BorderBrush="{StaticResource NeonFrame}" BorderThickness="0,0,2,0">
            <DockPanel LastChildFill="False" Margin="12,14">
                <Image DockPanel.Dock="Top" Source="pack://application:,,,/RibbixLauncher;component/Assets/main/logo.png" Height="86" Margin="0,0,0,10" />
                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavItem}" Tag="home" Content="Главная" IsChecked="True" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="catalog" Content="Каталог" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="modpack" Content="Сборки" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="servers" Content="Серверы" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="java" Content="Java" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="crown" Content="Подписка" Foreground="#FDE68A" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="profile" Content="Профиль" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="settings" Content="Настройки" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource DangerButton}">
                    <StackPanel Orientation="Horizontal">
                        <v:PixelIcon Kind="exit" Width="16" Height="16" Foreground="#FCA5A5" Margin="0,0,6,0" />
                        <TextBlock Text="Выход" Foreground="#FCA5A5" FontFamily="{StaticResource PixelFont}" FontSize="15" TextOptions.TextRenderingMode="Aliased" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Главная -->
        <Grid Grid.Column="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <v:PixelIcon Kind="profile" Width="16" Height="16" Margin="0,0,6,0" Foreground="#A7F3D0" />
                        <TextBlock Text="Lagushechka · Microsoft" FontFamily="{StaticResource PixelFont}" FontSize="15" TextOptions.TextRenderingMode="Aliased" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="🔎  Поиск  Ctrl+K" />
                <TextBlock Text="Главная" Style="{StaticResource H1}" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,16,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="380" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/RibbixLauncher;component/Assets/main/logo.png" Height="230" HorizontalAlignment="Left" />
                    <TextBlock Text="Квакнем по-крупному 🐸" Style="{StaticResource H2}" Margin="0,14,0,0" />
                    <TextBlock Text="Ванилла, Fabric, Quilt, Forge и NeoForge — в один клик." Style="{StaticResource Muted}" />
                </StackPanel>

                <v:PixelBorder Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Center">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <v:PixelIcon Kind="stats" Width="22" Height="22" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="Сегодня в пруду" Style="{StaticResource H2}" />
                        </StackPanel>
                        <TextBlock Text="2 ч 14 мин за неделю · серия 4 дня" Style="{StaticResource Muted}" Margin="0,6,0,10" />
                        <ProgressBar Value="64" Maximum="100" />
                        <TextBlock Text="До «Опытный» 🐸 осталось 3 ч 40 мин" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,12" />
                        <WrapPanel>
                            <Button Style="{StaticResource AccentButton}" Content="🎁 Мой год" Margin="0,0,8,6" />
                            <Button Style="{StaticResource GhostButton}" Content="📊 Статистика" Margin="0,0,8,6" />
                            <Button Style="{StaticResource GhostButton}" Content="🌍 Миры" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </v:PixelBorder>
            </Grid>

            <!-- Нижняя панель -->
            <v:PixelBorder Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/RibbixLauncher;component/Assets/ui/frog_idle.png" Height="62" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Версия" Style="{StaticResource Muted}" FontSize="12" />
                        <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="0,4,0,0">
                            <TextBlock Text="Wizards RPG · 1.19.2 Fabric   ▾" FontFamily="{StaticResource PixelFont}" FontSize="15" TextOptions.TextRenderingMode="Aliased" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="22,0">
                        <TextBlock Text="Скачиваем библиотеки · 62%" FontWeight="SemiBold" />
                        <ProgressBar Value="62" Maximum="100" Margin="0,6" />
                        <TextBlock Text="38,2 МБ из 61,5 МБ · 12,4 МБ/с · осталось 2 с" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource PlayButton}">
                        <StackPanel Orientation="Horizontal">
                            <v:PixelIcon Kind="play" Width="26" Height="26" Foreground="#06210F" Margin="0,0,12,0" />
                            <TextBlock Text="ИГРАТЬ" Foreground="#06210F" FontFamily="{StaticResource TitleFont}" FontSize="24" TextOptions.TextRenderingMode="Aliased" />
                        </StackPanel>
                    </Button>
                </Grid>
            </v:PixelBorder>
        </Grid>
    </Grid>
</Grid>
