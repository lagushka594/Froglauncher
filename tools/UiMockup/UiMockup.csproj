<Project Sdk="Microsoft.NET.Sdk">
  <!-- Макеты экранов в новом стиле: настоящие стили из Themes/*.xaml, рендер в PNG без запуска лаунчера. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\RibbixLauncher\RibbixLauncher.csproj" />
  </ItemGroup>
</Project>
