<Window x:Class="FrogLauncherSetup.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="350" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Grid>
        <Image Source="/Assets/panel_warning.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
        <Grid Margin="38,34,38,44">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Margin="60,2,0,0" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,34,0,8" TextWrapping="Wrap" FontSize="14" Foreground="#E3EEE6"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="YesBtn" Content="Да" Style="{StaticResource GreenButton}" Padding="26,8" Margin="0,0,10,0"/>
                <Button x:Name="NoBtn" Content="Нет" Style="{StaticResource GreenButton}" Padding="22,8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
