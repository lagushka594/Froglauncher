<Window x:Class="FrogLauncherSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FrogLauncher — установка" Width="700" Height="506" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <!-- рамка окна из ассета (заголовок нарисован на картинке) -->
        <Image Source="/Assets/installer_window.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- перетаскивание за заголовок -->
        <Rectangle x:Name="DragZone" Fill="Transparent" VerticalAlignment="Top" Height="86" Margin="0,8,110,0"/>
        <Button x:Name="MinBtn" Width="32" Height="28" Margin="0,42,76,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" Cursor="Hand" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Width="36" Height="32" Margin="0,38,22,0" HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0" Cursor="Hand" ToolTip="Закрыть"/>

        <!-- область страниц -->
        <Grid Margin="52,120,52,56">

            <!-- 0. Приветствие -->
            <Grid x:Name="PageWelcome">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Image Source="/Assets/installer_splash.png" Width="200" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Добро пожаловать!" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10,0,0" Foreground="#C9DCCF"
                               Text="Мастер установит FrogLauncher — лаунчер Minecraft с модами Modrinth и CurseForge, Fabric, Forge и автоустановкой Java."/>
                    <TextBlock x:Name="PayloadWarn" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"
                               Text="Установщик собран без лаунчера. Запустите build.bat."/>
                </StackPanel>
            </Grid>

            <!-- 1. Папка и параметры -->
            <Grid x:Name="PageOptions" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/icon_folder.png" Width="56" Height="50" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Куда установить?" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="DirBox"/>
                        <Button x:Name="BrowseBtn" Grid.Column="1" Content="Обзор…" Style="{StaticResource GreenButton}" Margin="8,0,0,0"/>
                    </Grid>
                    <CheckBox x:Name="DesktopChk" Content="Ярлык «FrogLauncher» на рабочем столе" IsChecked="True" Margin="0,16,0,0"/>
                    <CheckBox x:Name="StartChk" Content="Ярлык в меню «Пуск»" IsChecked="True"/>
                    <TextBlock x:Name="OptErr" Foreground="#E5484D" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <!-- 2. Установка -->
            <Grid x:Name="PageInstall" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="/Assets/installer_text.png" Width="430" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Grid Margin="30,10,30,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="Bar" Value="0" VerticalAlignment="Center"/>
                        <Image x:Name="Spin" Grid.Column="1" Source="/Assets/loader.png" Width="38" Height="38" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><RotateTransform/></Image.RenderTransform>
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.6"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                    </Grid>
                    <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="{StaticResource Muted}" Text="Подготовка…"/>
                </StackPanel>
            </Grid>

            <!-- 3. Готово -->
            <Grid x:Name="PageDone" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/Assets/icon_success.png" Width="64" Height="64" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FrogLauncher установлен!" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Image Source="/Assets/installer_toast.png" Width="330" Margin="0,12,0,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <CheckBox x:Name="RunChk" Content="Запустить FrogLauncher" IsChecked="True" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="14"/>
                </StackPanel>
            </Grid>

            <!-- 4. Ошибка -->
            <Grid x:Name="PageError" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="480">
                    <Image Source="/Assets/icon_error.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Не удалось установить" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ErrText" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Foreground="#C9DCCF"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- кнопки внизу -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,50">
            <Button x:Name="BackBtn" Style="{StaticResource ImageButton}" Margin="0,0,10,0" Visibility="Collapsed">
                <Image Source="/Assets/btn_back.png" Height="44" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button x:Name="NextBtn" Style="{StaticResource ImageButton}" Margin="0,0,10,0">
                <Image Source="/Assets/btn_next.png" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button x:Name="InstallBtn" Style="{StaticResource ImageButton}" Margin="0,0,10,0" Visibility="Collapsed">
                <Image Source="/Assets/btn_install.png" Height="50" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
            <Button x:Name="FinishBtn" Content="Готово" Style="{StaticResource GreenButton}" Padding="30,10" FontSize="15" Margin="0,0,10,0" Visibility="Collapsed"/>
            <Button x:Name="CancelBtn" Style="{StaticResource ImageButton}">
                <Image Source="/Assets/btn_cancel.png" Height="42" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
