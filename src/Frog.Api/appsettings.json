{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Frog": "Host=localhost;Port=5432;Database=frog;Username=frog"
  },
  "Jwt": {
    "Issuer": "frog-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "ServiceTokenMinutes": 15
  },
  "Billing": {
    "DefaultProvider": "manual",
    "PublicBaseUrl": "https://api.froglauncher.example",
    "GraceDays": 7,
    "RenewalLeadHours": 24,
    "MaxRenewalAttempts": 3
  },
  "YooKassa": {
    "ApiBase": "https://api.yookassa.ru/v3/",
    "EnforceIpAllowlist": true
  },
  "Paddle": {
    "ApiBase": "https://api.paddle.com/",
    "Prices": {
      "froglet:month": "", "froglet:year": "",
      "frog_plus:month": "", "frog_plus:year": "",
      "frog_pro:month": "", "frog_pro:year": "",
      "frog_legend:month": "", "frog_legend:year": ""
    }
  },
  "KnownProxies": []
}
