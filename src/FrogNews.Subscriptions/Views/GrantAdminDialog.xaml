<Window x:Class="FrogNews.Subscriptions.Views.GrantAdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выдать Admin" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#0F172A" FontFamily="Segoe UI" FontSize="14"
        FocusManager.FocusedElement="{Binding ElementName=ReasonBox}">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/FrogNews.Subscriptions;component/Views/Styles.xaml" />
    </Window.Resources>
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource FnAdminBadge}" VerticalAlignment="Center">
                <TextBlock Text="ADMIN" FontWeight="Black" Foreground="White" />
            </Border>
            <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Margin="10,0,0,0">
                <Run Text="Выдать пользователю " /><Run Text="{Binding Nick, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
        <TextBlock Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Admin даёт все функции FrogLauncher и доступ к публикации новостей и управлению пользователями. Выдача попадёт в аудит." />

        <TextBlock Text="Причина (обязательно, от 5 символов)" Foreground="#94A3B8" Margin="0,14,0,4" />
        <TextBox x:Name="ReasonBox" Style="{StaticResource FnInput}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70" MaxLength="500" />

        <TextBlock Foreground="#94A3B8" Margin="0,14,0,4" TextWrapping="Wrap">
            <Run Text="Для подтверждения введите слово " /><Run Text="ADMIN" FontWeight="Bold" Foreground="#A78BFA" />
        </TextBlock>
        <TextBox Style="{StaticResource FnInput}" Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource FnGhost}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource FnAdminButton}" Content="Выдать Admin" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
