<UserControl x:Class="FrogNews.Subscriptions.Views.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FrogNews.Subscriptions.Views"
             Background="{DynamicResource FnBg}" Foreground="#E2E8F0" FontFamily="Segoe UI" FontSize="14">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/FrogNews.Subscriptions;component/Views/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <local:NotEmptyToVisibilityConverter x:Key="NotEmpty" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource FnMuted}">
                <Run Text="Оператор: " /><Run Text="{Binding Operator, Mode=OneWay}" FontWeight="SemiBold" Foreground="White" />
            </TextBlock>
            <StackPanel>
                <TextBlock Text="Подписки FrogLauncher" FontSize="24" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Раздел доступен только superadmin. Все действия попадают в аудит." Foreground="{StaticResource FnMuted}" />
            </StackPanel>
        </DockPanel>

        <Border DockPanel.Dock="Top" Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,10"
                Visibility="{Binding Error, Converter={StaticResource NotEmpty}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <TabControl Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd" Padding="16,8" Margin="0,0,6,0" CornerRadius="8,8,0,0" Background="#1E293B" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" TextElement.Foreground="White" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#22C55E" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ===== Пользователи ===== -->
            <TabItem Header="Пользователи">
                <Border Background="{StaticResource FnPanel}" CornerRadius="0,10,10,10" Padding="14">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource FnButton}" Content="Выдать подписку" Command="{Binding GrantSubscriptionCommand}" Margin="8,0,0,0"
                                        ToolTip="После оплаты через тикет в Discord" />
                                <Button Style="{StaticResource FnGhost}" Content="Снять подписку" Command="{Binding RevokeSubscriptionCommand}" Margin="8,0,0,0" />
                                <Button Style="{StaticResource FnAdminButton}" Content="Выдать Admin" Command="{Binding GrantCommand}" Margin="8,0,0,0" />
                                <Button Style="{StaticResource FnDangerButton}" Content="Снять Admin" Command="{Binding RevokeCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBox Style="{StaticResource FnInput}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Поиск по нику или email" />
                        </DockPanel>

                        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource FnMuted}">
                                <Run Text="Всего: " /><Run Text="{Binding Total, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource FnGhost}" Content="‹ Назад" Command="{Binding PrevPageCommand}" />
                                <TextBlock VerticalAlignment="Center" Margin="12,0" Foreground="White">
                                    <Run Text="{Binding Page, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalPages, Mode=OneWay}" />
                                </TextBlock>
                                <Button Style="{StaticResource FnGhost}" Content="Вперёд ›" Command="{Binding NextPageCommand}" />
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Style="{StaticResource FnGrid}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ник" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding LauncherNick}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource FnAdminBadge}" Margin="8,0,0,0"
                                                        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ADMIN" FontSize="11" FontWeight="Black" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Email" Binding="{Binding EmailMasked}" Width="2*" />
                                <DataGridTextColumn Header="Тир" Binding="{Binding Tier}" Width="*" />
                                <DataGridTextColumn Header="Окончание" Binding="{Binding PeriodEnd, StringFormat={}{0:dd.MM.yyyy}, TargetNullValue='—'}" Width="*" />
                                <DataGridTextColumn Header="Регистрация" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- ===== Аудит ===== -->
            <TabItem Header="Аудит">
                <Border Background="{StaticResource FnPanel}" CornerRadius="0,10,10,10" Padding="14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                            <Button Style="{StaticResource FnGhost}" Content="⟳ Обновить" Command="{Binding LoadAuditCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource FnButton}" Content="Экспорт CSV" Command="{Binding ExportCsvCommand}" />
                        </StackPanel>
                        <DataGrid Style="{StaticResource FnGrid}" ItemsSource="{Binding Audit}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Кому" Binding="{Binding UserNick}" Width="*" />
                                <DataGridTextColumn Header="Тариф" Binding="{Binding Tier}" Width="*" />
                                <DataGridTextColumn Header="Выдал" Binding="{Binding GrantedBy}" Width="*" />
                                <DataGridTextColumn Header="Когда" Binding="{Binding GrantedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="*" />
                                <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="2*" />
                                <DataGridTextColumn Header="Снял" Binding="{Binding RevokedBy, TargetNullValue='—'}" Width="*" />
                                <DataGridTextColumn Header="Когда снят" Binding="{Binding RevokedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}, TargetNullValue='активен'}" Width="*" />
                                <DataGridTextColumn Header="Причина снятия" Binding="{Binding RevokeReason, TargetNullValue='—'}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
