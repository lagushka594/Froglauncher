<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Установщик FrogLauncher (FrogLauncherSetup.exe).
    .NET Framework 4.8 встроен в Windows 10/11 → установщику не нужен свой рантайм, файл маленький.
    Полезная нагрузка — Payload\payload.zip (собирается build\build.ps1 из publish лаунчера).
    Установка — в профиль пользователя, без прав администратора.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>FrogLauncherSetup</AssemblyName>
    <RootNamespace>FrogLauncher.Installer</RootNamespace>
    <ApplicationIcon>..\..\assets\out\installer\installer_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\out\installer\*.png" Link="Assets\%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\out\installer\installer_icon.ico" Link="Assets\installer_icon.ico" />
    <!-- EmbedPayload=false — сборка лёгкого деинсталлятора (тот же exe без лаунчера внутри). -->
    <EmbeddedResource Include="Payload\payload.zip" Condition="'$(EmbedPayload)' != 'false' And Exists('Payload\payload.zip')" LogicalName="FrogLauncher.Payload.zip" />
    <EmbeddedResource Include="Payload\uninstall.exe" Condition="'$(EmbedPayload)' != 'false' And Exists('Payload\uninstall.exe')" LogicalName="FrogLauncher.Uninstaller.exe" />
  </ItemGroup>

</Project>
