<Window x:Class="FrogLauncher.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка FrogLauncher" Width="720" Height="524" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Icon="Assets/installer_icon.ico" FontFamily="Segoe UI">

    <Window.Resources>
        <Storyboard x:Key="Spin" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="LoaderRotate" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1.4" />
        </Storyboard>
        <Storyboard x:Key="Float" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="FrogFloat" Storyboard.TargetProperty="Y" From="0" To="-8" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Рамка окна из ассета installer_window.png. -->
        <Image Source="Assets/installer_window.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Перетаскивание окна за заголовок и кнопки «свернуть»/«закрыть» поверх нарисованных. -->
        <Border Height="86" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="Drag" />
        <Button Width="44" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,72,0" Opacity="0"
                Cursor="Hand" ToolTip="Свернуть" Click="Minimize_Click" />
        <Button x:Name="CloseX" Width="44" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,22,0" Opacity="0"
                Cursor="Hand" ToolTip="Закрыть" Click="Cancel_Click" />

        <Grid Margin="30,96,30,30">

            <!-- ===== 1. Приветствие ===== -->
            <Grid x:Name="PageWelcome">
                <Grid.RowDefinitions>
                    <RowDefinition Height="190" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border CornerRadius="12" ClipToBounds="True">
                    <Border.Background>
                        <ImageBrush ImageSource="Assets/installer_bg.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Grid.Row="1" Margin="4,14,4,0">
                    <TextBlock Text="Добро пожаловать в FrogLauncher 🐸" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" Foreground="#93A3B8" Margin="0,6,0,0" FontSize="13"
                               Text="Неофициальный лаунчер Minecraft с открытым кодом: ванилла, Fabric, Quilt, Forge и NeoForge. Не связан с Mojang и Microsoft." />
                    <CheckBox x:Name="AcceptBox" Margin="0,10,0,0" Checked="Accept_Changed" Unchecked="Accept_Changed">
                        <TextBlock Foreground="#E7F8EC" TextWrapping="Wrap">
                            <Run Text="Я принимаю лицензию MIT и понимаю, что это неофициальный лаунчер" />
                        </TextBlock>
                    </CheckBox>
                </StackPanel>
                <DockPanel Grid.Row="2">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ImgButton}" Click="Cancel_Click">
                        <Image Source="Assets/btn_cancel.png" Height="54" />
                    </Button>
                    <Button x:Name="NextButton" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ImgButton}" Click="Next_Click" IsEnabled="False">
                        <Image Source="Assets/btn_next.png" Height="54" />
                    </Button>
                </DockPanel>
            </Grid>

            <!-- ===== 2. Параметры ===== -->
            <Grid x:Name="PageOptions" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="4,4,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Assets/icon_settings.png" Height="44" Margin="0,0,12,0" />
                        <TextBlock Text="Куда поселить лягушку?" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="Папка установки" Foreground="#93A3B8" Margin="0,18,0,6" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ImgButton}" Click="Browse_Click" ToolTip="Выбрать папку" Margin="8,0,0,0">
                            <Image Source="Assets/icon_folder.png" Height="44" />
                        </Button>
                        <TextBox x:Name="DirBox" FontSize="14" Padding="8,8" Background="#0E1628" Foreground="#E7F8EC"
                                 BorderBrush="#24314F" CaretBrush="#22C55E" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="SpaceText" Foreground="#93A3B8" Margin="0,6,0,0" FontSize="12" />

                    <CheckBox x:Name="DesktopBox" Content="Ярлык на рабочем столе" IsChecked="True" Margin="0,16,0,0" />
                    <CheckBox x:Name="StartMenuBox" Content="Ярлык в меню «Пуск»" IsChecked="True" />
                    <CheckBox x:Name="LaunchBox" Content="Запустить FrogLauncher после установки" IsChecked="True" />
                    <TextBlock Foreground="#93A3B8" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Права администратора не нужны. Миры и настройки хранятся отдельно в %AppData%\FrogLauncher." />
                </StackPanel>
                <DockPanel Grid.Row="1">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ImgButton}" Click="Back_Click">
                        <Image Source="Assets/btn_back.png" Height="54" />
                    </Button>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource ImgButton}" Click="Install_Click">
                        <Image Source="Assets/btn_install.png" Height="60" />
                    </Button>
                </DockPanel>
            </Grid>

            <!-- ===== 3. Установка / удаление ===== -->
            <Grid x:Name="PageProgress" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="Assets/installer_splash.png" Height="150">
                        <Image.RenderTransform><TranslateTransform x:Name="FrogFloat" /></Image.RenderTransform>
                    </Image>
                    <Image Source="Assets/installer_text.png" Height="78" Margin="0,4,0,0" />
                    <Grid Margin="20,14,20,0">
                        <Border Height="22" CornerRadius="11" Background="#0A101E" BorderBrush="#06B6D4" BorderThickness="2" />
                        <Border x:Name="Fill" Height="14" CornerRadius="7" Margin="4,0" HorizontalAlignment="Left" Width="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#22C55E" Offset="0" />
                                    <GradientStop Color="#06B6D4" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect Color="#22C55E" BlurRadius="12" ShadowDepth="0" /></Border.Effect>
                        </Border>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Image Source="Assets/loader.png" Height="24" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform><RotateTransform x:Name="LoaderRotate" /></Image.RenderTransform>
                        </Image>
                        <TextBlock x:Name="StatusText" Text="Готовимся…" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" />
                    </StackPanel>
                    <Image Source="Assets/installer_toast.png" Height="62" Margin="0,12,0,0" />
                </StackPanel>
            </Grid>

            <!-- ===== 4. Готово ===== -->
            <Grid x:Name="PageDone" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image x:Name="DoneIcon" Source="Assets/icon_success.png" Height="110" />
                    <TextBlock x:Name="DoneTitle" Text="FrogLauncher установлен!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="DoneText" Text="Квак! Можно играть." Foreground="#93A3B8" HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="520" Margin="0,6,0,0" />
                    <Button x:Name="FinishButton" Content="Готово" Style="{StaticResource TextButton}" HorizontalAlignment="Center" Margin="0,22,0,0" Click="Finish_Click" />
                </StackPanel>
            </Grid>

            <!-- ===== Удаление: подтверждение ===== -->
            <Grid x:Name="PageUninstall" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Image Source="Assets/icon_warning.png" Height="100" />
                    <TextBlock Text="Удалить FrogLauncher?" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Foreground="#93A3B8" HorizontalAlignment="Center" Margin="0,6,0,0" Text="Программа и ярлыки будут удалены." />
                    <CheckBox x:Name="RemoveDataBox" HorizontalAlignment="Center" Margin="0,16,0,0"
                              Content="Также удалить миры, моды и настройки (%AppData%\FrogLauncher)" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                        <Button Style="{StaticResource ImgButton}" Click="Cancel_Click" Margin="0,0,14,0">
                            <Image Source="Assets/btn_cancel.png" Height="54" />
                        </Button>
                        <Button Content="Удалить" Style="{StaticResource DangerTextButton}" Click="Uninstall_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
