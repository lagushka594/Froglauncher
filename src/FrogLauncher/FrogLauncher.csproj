<Project Sdk="Microsoft.NET.Sdk">

  <!--
    FrogLauncher — WPF (.NET 8).
    Почему WPF, а не Avalonia: лаунчер завязан на Windows (DPAPI, реестр для поиска Java и
    URL-схемы froglauncher://, Win32 процессы), FrogNews уже на WPF — общие стили, навыки и
    инструменты команды. Avalonia имеет смысл, только когда понадобятся macOS/Linux.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms только ради NotifyIcon (трей); его глобальные using отключены, чтобы не путать с WPF. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- DPI задаётся в app.manifest — так же, как до трея (WinForms нужен только для NotifyIcon). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <AssemblyName>FrogLauncher</AssemblyName>
    <RootNamespace>FrogLauncher</RootNamespace>
    <ApplicationIcon>..\..\assets\out\ui\icon_frog.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="DnsClient" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Frog.Shared\Frog.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FrogLauncher.Tests" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Ассеты, нарезанные из атласов (tools/AssetCutter), вшиваются как WPF-ресурсы. -->
  <ItemGroup>
    <Resource Include="..\..\assets\out\**\*.png" Exclude="..\..\assets\out\_contact_sheet.png"
              Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="..\..\assets\out\ui\icon_frog.ico" Link="Assets\ui\icon_frog.ico" />
  </ItemGroup>

  <!-- Тот же tiers.json, что на сервере: карточки тарифов видны, даже когда сервер недоступен. -->
  <ItemGroup>
    <EmbeddedResource Include="..\Frog.Api\tiers.json" LogicalName="FrogLauncher.tiers.json" />
    <!-- Резервная копия списка серверов (основной — servers.json в репозитории на GitHub). -->
    <EmbeddedResource Include="..\..\servers.json" LogicalName="FrogLauncher.servers.json" />
    <EmbeddedResource Include="..\..\promos.json" LogicalName="FrogLauncher.promos.json" />
    <!-- Словари локализации: ключ — русская строка (Lang/ru.json — исходник для Crowdin). -->
    <EmbeddedResource Include="Lang\*.json" Exclude="Lang\ru.json" LogicalName="FrogLauncher.Lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
