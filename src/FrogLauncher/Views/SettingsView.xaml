<UserControl x:Class="FrogLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FrogLauncher.Core"
             xmlns:v="clr-namespace:FrogLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/main/btn_settings.png" Height="48" Margin="0,0,12,0" />
                        <TextBlock Text="{l:T 'Настройки'}" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    </StackPanel>

                    <DockPanel Margin="0,18,0,0">
                        <ComboBox DockPanel.Dock="Right" Width="220" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding Language}"
                                  DisplayMemberPath="NativeName" AutomationProperties.Name="Language" />
                        <TextBlock Text="{l:T '🌐 Язык интерфейса'}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border CornerRadius="10" Padding="12,8" Margin="0,8,0,0" Background="#2222C55E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource VisibleIf}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T 'Перезапустить'}" Command="{Binding RestartForLanguageCommand}" />
                            <TextBlock Text="{l:T 'Язык сменится после перезапуска лаунчера.'}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{l:T 'Нашли ошибку в переводе? Напишите нам в Discord — переводы обновляются вместе с лаунчером.'}" />

                    <CheckBox Style="{StaticResource Toggle}" Margin="0,18,0,0" IsChecked="{Binding DiscordPresence}"
                              Content="{l:T 'Показывать активность в Discord («Играет в FrogLauncher», версия, загрузки)'}" />
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,12,0,0" IsChecked="{Binding CloseOnLaunch}"
                              Content="{l:T 'Сворачивать лаунчер после запуска игры'}" />

                    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,4">
                        <Run Text="{l:T 'RAM по умолчанию для новых версий: '}" /><Run Text="{Binding Value, ElementName=Ram, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text="{l:T ' МБ'}" />
                    </TextBlock>
                    <Slider x:Name="Ram" Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding DefaultRamMb}" Width="420" HorizontalAlignment="Left" />

                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Открыть папку данных'}" Command="{Binding OpenDataFolderCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <!-- Обновления -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T 'Проверить сейчас'}" Command="{Binding CheckUpdateCommand}" />
                        <StackPanel>
                            <TextBlock Text="{l:T 'Обновления'}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Версия FrogLauncher '}" /><Run Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,12,0,0" IsChecked="{Binding AutoUpdate}"
                              Content="{l:T 'Проверять и скачивать обновления в фоне при запуске'}" />
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,10,0,0" IsChecked="{Binding BetaChannel}" IsEnabled="{Binding CanUseBeta}"
                              Content="{l:T 'Бета-канал — новые функции раньше всех (Frog+ и выше)'}" />
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" Foreground="{DynamicResource AccentBrush}"
                               Visibility="{Binding UpdateStatus, Converter={StaticResource VisibleIf}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T 'Трей и напоминания'}" Style="{StaticResource H2}" />
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,12,0,0" IsChecked="{Binding MinimizeToTray}"
                              Content="{l:T 'Крестик сворачивает лаунчер в трей (рядом с часами), а не закрывает'}" />
                    <DockPanel Margin="0,12,0,0">
                        <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding ReminderOptions}" SelectedIndex="{Binding ReminderHours}" />
                        <TextBlock Text="{l:T 'Напоминать сделать перерыв во время игры'}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Горячие клавиши -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'По умолчанию'}" Command="{Binding ResetHotkeysCommand}" />
                        <StackPanel>
                            <TextBlock Text="{l:T 'Горячие клавиши'}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Нажмите на сочетание и введите новое. Esc — отмена, Backspace — отключить.'}" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Hotkeys}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,14,6">
                                    <Button DockPanel.Dock="Right" Width="170" Style="{StaticResource GhostButton}" Content="{Binding Display}" Padding="8,5"
                                            Click="Hotkey_Click" Tag="{Binding}" FontFamily="Consolas" />
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{l:T 'Темы'}" Style="{StaticResource H2}" />
                    <TextBlock Text="{l:T 'Премиум-темы открываются подпиской. Если подписка закончится — вернётся «Болото».'}" Style="{StaticResource Muted}" />
                    <TextBlock Text="{l:T 'Сезонные темы бесплатные: «Сезонная (авто)» сама меняется — весна, лето, осень, зима и Новый год (20 декабря — 10 января).'}"
                               Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,10,0,0" IsChecked="{Binding SeasonEffects}"
                              Content="{l:T 'Сезонные эффекты: лепестки, листья, снег, гирлянды (пауза во время игры)'}" />
                    <CheckBox Style="{StaticResource Toggle}" Margin="0,8,0,0" IsChecked="{Binding StartupSound}"
                              Content="{l:T 'Звук сезона при запуске: птицы, кваканье, листья, снег, Jingle Bells'}" />
                    <ItemsControl ItemsSource="{Binding Themes}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ImageButton}" Margin="0,0,10,10"
                                        Command="{Binding DataContext.ApplyThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Border x:Name="Card" Width="150" CornerRadius="12" Padding="12" BorderThickness="2" BorderBrush="#33FFFFFF" Background="{Binding Theme.Surface}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="22" Height="22" Fill="{Binding Theme.Accent}" />
                                                <Ellipse Width="22" Height="22" Fill="{Binding Theme.Accent2}" Margin="-6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Theme.Name}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                <Run Text="{Binding Theme.RequiresLabel, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{l:T '🔒 Заблокирована'}" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                                       Visibility="{Binding Unlocked, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                        </StackPanel>
                                    </Border>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
