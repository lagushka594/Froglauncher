<UserControl x:Class="FrogLauncher.Views.InstancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FrogLauncher.Core"
             xmlns:v="clr-namespace:FrogLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
        <v:NullableIntConverter x:Key="NullableInt" />
        <v:NotConverter x:Key="Not" />
    </UserControl.Resources>

    <!-- Перетащите .mrpack / .zip сборки или мира — импорт. -->
    <Grid AllowDrop="True" Drop="Catalog_Drop" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Список инстансов. -->
        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T '+ Добавить'}" Command="{Binding StartCreateCommand}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T '📥 Импорт'}" Command="{Binding ImportPackCommand}"
                            Margin="0,0,8,0" ToolTip="{l:T '.mrpack (Modrinth), полная копия FrogLauncher или экспорт Prism/MultiMC. Можно просто перетащить файл сюда.'}" />
                    <StackPanel>
                        <TextBlock Text="{l:T 'Мои версии'}" Style="{StaticResource H2}" />
                        <TextBlock Text="{Binding LimitText}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </DockPanel>

                <!-- Импорт: прогресс. -->
                <Border DockPanel.Dock="Top" CornerRadius="10" Padding="10,8" Margin="0,0,0,10" Background="#1522C55E"
                        Visibility="{Binding IsImporting, Converter={StaticResource VisibleIf}}">
                    <StackPanel DataContext="{Binding ImportProgress}">
                        <TextBlock Text="{Binding Stage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Height="6" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Мягкий апселл при лимите. -->
                <Border DockPanel.Dock="Top" CornerRadius="10" Padding="12" Margin="0,0,0,10" Background="#22F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                        Visibility="{Binding Upsell, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/ui/frog_surprise.png" Height="28" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Upsell}" TextWrapping="Wrap" MaxWidth="220" />
                        </StackPanel>
                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Сравнить'}" Command="{Binding CompareCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="10" Padding="10,8" Margin="0,3" Background="#10FFFFFF" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="Bd" Property="Background" Value="#2222C55E" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1822C55E" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding IconUrl, TargetNullValue=/Assets/ui/minecraft.png}" Height="34" MaxWidth="80" Margin="0,0,10,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayVersion}" Style="{StaticResource Muted}" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Создание инстанса. -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Visibility="{Binding IsCreating, Converter={StaticResource VisibleIf}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{l:T 'Новая версия'}" Style="{StaticResource H1}" />
                    <TextBlock Text="{l:T 'Название'}" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Text="{l:T 'Версия Minecraft'}" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox Style="{StaticResource Check}" Content="{l:T 'Релизы'}" IsChecked="{Binding ShowRelease}" Margin="0,0,16,0" />
                        <CheckBox Style="{StaticResource Check}" Content="{l:T 'Снапшоты'}" IsChecked="{Binding ShowSnapshot}" Margin="0,0,16,0" />
                        <CheckBox Style="{StaticResource Check}" Content="{l:T 'Старые (beta/alpha)'}" IsChecked="{Binding ShowOld}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding NewVersion}" MaxDropDownHeight="320">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{l:T 'Модлоадер'}" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                    <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding NewLoader}" />

                    <StackPanel Visibility="{Binding LoaderVersions.Count, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{l:T 'Версия модлоадера'}" Style="{StaticResource Muted}" Margin="0,14,0,4" />
                        <ComboBox ItemsSource="{Binding LoaderVersions}" SelectedItem="{Binding NewLoaderVersion}" DisplayMemberPath="Label" MaxDropDownHeight="320" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding LoadingLoaders, Converter={StaticResource VisibleIf}}">
                        <Image Source="/Assets/ui/loader.png" Height="20" Style="{StaticResource Spinning}" />
                        <TextBlock Text="{l:T '  Получаем версии…'}" Style="{StaticResource Muted}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="{l:T 'Создать'}" Command="{Binding CreateCommand}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Отмена'}" Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,12,0,0"
                               Text="{l:T 'Файлы игры скачаются при первом запуске. Forge поддерживается от 1.7.10, NeoForge — от 1.20.2.'}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===== Настройки выбранной версии: вкладки ===== -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14"
                Visibility="{Binding IsCreating, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
            <DockPanel DataContext="{Binding SettingsPanel}" Visibility="{Binding Converter={StaticResource VisibleIf}}">
                <!-- Заголовок -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Content="{l:T 'Сохранить'}" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:T '📤 Экспорт'}" Command="{Binding TogglePackExportCommand}" Margin="0,0,8,0"
                                ToolTip="{l:T 'Сохранить версию как сборку .mrpack или полную копию .zip'}" />
                        <Button Style="{StaticResource ImageButton}" ToolTip="{l:T 'Открыть папку игры'}" Margin="0,0,8,0"
                                Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Image Source="/Assets/ui/folder.png" Height="36" />
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Content="{l:T 'Удалить'}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding Instance.Name}" Style="{StaticResource H1}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Instance.DisplayVersion}" Style="{StaticResource Muted}" />
                    </StackPanel>
                </DockPanel>

                <!-- Экспорт сборки -->
                <Border DockPanel.Dock="Top" CornerRadius="10" Padding="14,12" Margin="0,0,0,10" Background="#140A101E"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        Visibility="{Binding ShowPackExport, Converter={StaticResource VisibleIf}}">
                    <StackPanel>
                        <TextBlock Text="{l:T 'Экспорт сборки'}" Style="{StaticResource H2}" />
                        <RadioButton GroupName="fmt" IsChecked="{Binding ExportMrpack}" Margin="0,8,0,0" Foreground="{DynamicResource TextBrush}"
                                     Content="{l:T '.mrpack — формат Modrinth: откроют Modrinth App, Prism, ATLauncher и FrogLauncher. Моды с Modrinth — ссылками, файл маленький.'}" />
                        <RadioButton GroupName="fmt" Margin="0,6,0,0" Foreground="{DynamicResource TextBrush}"
                                     Content="{l:T '.zip — полная копия для FrogLauncher: всё внутри, с настройками памяти и Java. Для переноса на другой компьютер.'}" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ExportConfigs}" Margin="0,10,0,0"
                                  Content="{l:T 'Конфиги модов и настройки игры (config, options.txt)'}" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ExportWorlds}" Margin="0,8,0,0"
                                  Content="{l:T 'Миры (saves) — архив станет заметно больше'}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="{l:T 'Экспортировать…'}" Command="{Binding ExportPackCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource Not}}" />
                            <TextBlock Text="{Binding ExportStatus}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="420" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="{l:T 'Логи, скриншоты и бэкапы не переносятся. Аккаунты и пароли в сборку не попадают.'}" />
                    </StackPanel>
                </Border>

                <!-- Предупреждения валидации -->
                <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="10,5" Margin="0,0,0,6" Background="#26F59E0B" BorderBrush="#F59E0B" BorderThickness="1">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TabControl Style="{StaticResource SettingsTabs}">
                    <!-- ================= Графика ================= -->
                    <TabItem Header="{l:T '🎨 Графика'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,8,8">
                                <!-- Умные пресеты -->
                                <Border CornerRadius="12" Padding="12" Background="#141F7A4C" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Сбросить до рекомендуемых'}" Command="{Binding ResetRecommendedCommand}" />
                                            <TextBlock Text="{l:T '🧠 Подобрать под мой ПК'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding HardwareText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding RecommendationText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="0,4,0,8" />
                                        <ItemsControl ItemsSource="{Binding Presets}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="0,0,8,0" Cursor="Hand" Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,8">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="11" Height="11" Fill="{Binding Color}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding ForWhom}" Style="{StaticResource Muted}" FontSize="11" />
                                                            <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{l:T 'Качество'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="{l:T 'Графика'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding GraphicsModes}" SelectedIndex="{Binding GraphicsMode}"
                                                  ToolTip="{l:T 'Fabulous добавляет прозрачность и эффекты — самый требовательный режим'}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{l:T 'Облака'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding CloudModes}" SelectedIndex="{Binding Clouds}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="{l:T 'Частицы'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding ParticleModes}" SelectedIndex="{Binding Particles}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Смешивание биомов: '}" /><Run Text="{Binding BiomeBlend, Mode=OneWay}" /></TextBlock>
                                        <Slider Minimum="0" Maximum="7" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding BiomeBlend}"
                                                ToolTip="{l:T 'Плавный переход цвета травы и воды между биомами. Больше — красивее и медленнее'}" />
                                    </StackPanel>
                                </UniformGrid>
                                <WrapPanel>
                                    <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Плавное освещение'}" IsChecked="{Binding SmoothLighting}" Margin="0,4,24,4" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Тени сущностей'}" IsChecked="{Binding EntityShadows}" Margin="0,4,24,4" />
                                </WrapPanel>

                                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0">
                                    <Run Text="{l:T 'Дальность прорисовки: '}" /><Run Text="{Binding RenderHint, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                </TextBlock>
                                <Slider Minimum="2" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RenderDistance}"
                                        ToolTip="{l:T 'Сильнее всего влияет на FPS. Для слабых ПК — 8, для средних — 12, для мощных — 16–32'}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                                    <Run Text="{l:T 'Дальность симуляции: '}" /><Run Text="{Binding SimulationDistance, Mode=OneWay}" /><Run Text="{l:T ' чанков'}" />
                                </TextBlock>
                                <Slider Minimum="5" Maximum="32" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding SimulationDistance}"
                                        ToolTip="{l:T 'На каком расстоянии растут растения и двигаются мобы. Нагружает процессор'}" />

                                <TextBlock Text="{l:T 'Производительность'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Максимальный FPS: '}" /><Run Text="{Binding FpsText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                <Slider Minimum="30" Maximum="260" IsSnapToTickEnabled="True" TickFrequency="10" Value="{Binding MaxFps}"
                                        ToolTip="{l:T 'Крайнее правое положение — без ограничения'}" />
                                <UniformGrid Columns="2" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="Mipmap: " /><Run Text="{Binding Mipmap, Mode=OneWay}" /></TextBlock>
                                        <Slider Minimum="0" Maximum="4" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Mipmap}"
                                                ToolTip="{l:T 'Сглаживание дальних текстур. 0 — быстрее, 4 — красивее'}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Дальность сущностей: '}" /><Run Text="{Binding EntityDistance, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="50" Maximum="500" IsSnapToTickEnabled="True" TickFrequency="25" Value="{Binding EntityDistance}"
                                                ToolTip="{l:T 'На каком расстоянии видны мобы и предметы'}" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Вертикальная синхронизация (V-Sync)'}" IsChecked="{Binding VSync}" Margin="0,8,0,0"
                                          ToolTip="{l:T 'Убирает разрывы картинки, но ограничивает FPS частотой монитора'}" />

                                <TextBlock Text="{l:T 'Эффекты и камера'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Поле зрения (FOV): '}" /><Run Text="{Binding Fov, Mode=OneWay}" /><Run Text="°" /></TextBlock>
                                        <Slider Minimum="30" Maximum="110" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Fov}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Яркость: '}" /><Run Text="{Binding Brightness, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding Brightness}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Эффекты искажения: '}" /><Run Text="{Binding ScreenEffects, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding ScreenEffects}"
                                                ToolTip="{l:T 'Тряска и искажение экрана (тошнота, портал)'}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Эффекты FOV: '}" /><Run Text="{Binding FovEffects, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding FovEffects}"
                                                ToolTip="{l:T 'Изменение поля зрения при беге и зельях'}" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Покачивание камеры при ходьбе'}" IsChecked="{Binding BobView}" />

                                <TextBlock Text="{l:T 'Интерфейс'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="{l:T 'Размер интерфейса'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding GuiScales}" SelectedIndex="{Binding GuiScale}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Масштаб чата: '}" /><Run Text="{Binding ChatScale, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding ChatScale}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Непрозрачность чата: '}" /><Run Text="{Binding ChatOpacity, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding ChatOpacity}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Ширина чата: '}" /><Run Text="{Binding ChatWidth, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                        <Slider Minimum="10" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding ChatWidth}" />
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Sodium / Iris -->
                                <StackPanel Visibility="{Binding HasSodium, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="Sodium" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                    <TextBlock Text="{l:T 'Настройки появятся после первого запуска с Sodium.'}" Style="{StaticResource Muted}"
                                               Visibility="{Binding SodiumOptions.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding SodiumOptions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource Toggle}" Content="{Binding Label}" IsChecked="{Binding Value}" Margin="0,3" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Visibility="{Binding HasIris, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="{l:T 'Шейдеры (Iris)'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Включить шейдеры'}" IsChecked="{Binding ShadersEnabled}" />
                                    <ComboBox ItemsSource="{Binding ShaderPacks}" SelectedItem="{Binding SelectedShader}" Margin="0,8,0,0"
                                              ToolTip="{l:T 'Шейдерпаки из папки shaderpacks'}" />
                                    <TextBlock Text="{l:T 'Нет шейдерпаков — положите .zip в папку shaderpacks (вкладка «Моды и паки»).'}" Style="{StaticResource Muted}"
                                               Visibility="{Binding ShaderPacks.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"
                                           Text="{l:T 'Свечение, размытие в движении и глубина резкости — это эффекты шейдеров: поставьте Iris в «Моды и паки», и здесь появится выбор шейдерпака.'}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= Игра ================= -->
                    <TabItem Header="{l:T '🎮 Игра'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,8,8">
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="{l:T 'Язык игры'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Language}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{l:T 'Чат'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding ChatVisibilities}" SelectedIndex="{Binding ChatVisibility}" />
                                    </StackPanel>
                                </UniformGrid>
                                <WrapPanel>
                                    <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Автопрыжок'}" IsChecked="{Binding AutoJump}" Margin="0,4,24,4" />
                                    <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Демо-режим'}" IsChecked="{Binding Instance.Demo}" Margin="0,4,24,4" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"
                                           Text="{l:T 'Сложность и режим игры (выживание, творчество) задаются при создании мира в самой игре.'}" />

                                <TextBlock Text="{l:T 'Звук'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <ItemsControl ItemsSource="{Binding Sounds}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,12,6">
                                                <TextBlock Style="{StaticResource Muted}"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Value, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                                <Slider Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding Value}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{l:T 'Мышь'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Чувствительность: '}" /><Run Text="{Binding MouseSensitivity, Mode=OneWay}" /><Run Text="%" /></TextBlock>
                                <Slider Minimum="0" Maximum="200" IsSnapToTickEnabled="True" TickFrequency="5" Value="{Binding MouseSensitivity}" />
                                <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Инвертировать мышь по вертикали'}" IsChecked="{Binding InvertMouse}" Margin="0,6,0,0" />

                                <DockPanel Margin="0,16,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Стандартные клавиши'}" Command="{Binding ResetKeysCommand}" />
                                    <TextBlock Text="{l:T 'Управление'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{l:T 'Нажмите на клавишу справа, затем нужную клавишу или кнопку мыши. Esc — отмена.'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding Keys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,12,4">
                                                <Button DockPanel.Dock="Right" Width="130" Style="{StaticResource GhostButton}" Content="{Binding Display}" Padding="8,4"
                                                        Click="KeyBind_Click" Tag="{Binding}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= Производительность ================= -->
                    <TabItem Header="{l:T '⚡ Производительность'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,8,8">
                                <TextBlock Style="{StaticResource Muted}">
                                    <Run Text="{l:T 'Оперативная память для игры: '}" /><Run Text="{Binding RamText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                </TextBlock>
                                <TextBlock Text="{Binding RecommendationText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,2,0,6" />
                                <TextBlock Text="{l:T 'Максимум (-Xmx)'}" Style="{StaticResource Muted}" FontSize="12" />
                                <Slider Minimum="1024" Maximum="{Binding MaxRamMb}" IsSnapToTickEnabled="True" TickFrequency="512" Value="{Binding RamMax}" />
                                <TextBlock Text="{l:T 'Минимум (-Xms)'}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                <Slider Minimum="512" Maximum="{Binding RamMax}" IsSnapToTickEnabled="True" TickFrequency="512" Value="{Binding RamMin}" />

                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <StackPanel Margin="0,0,12,8">
                                        <TextBlock Text="{l:T 'Сборщик мусора'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding GcOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Gc}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{l:T 'Приоритет процесса'}" Style="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding PriorityOptions}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Priority}"
                                                  ToolTip="{l:T '«Высокий» помогает на слабых ПК. Режим реального времени не предлагаем — Windows может зависнуть'}" />
                                    </StackPanel>
                                </UniformGrid>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Autotune}" IsEnabled="{Binding CanAutotune}"
                                          Content="{l:T 'Автотюнинг JVM — флаги Aikar под G1GC (Frog+)'}" />

                                <TextBlock Text="{l:T 'Аргументы JVM'}" Style="{StaticResource Muted}" Margin="0,12,0,4" />
                                <TextBox Text="{Binding JvmArgs}" FontFamily="Consolas" ToolTip="{l:T 'Дополнительные флаги Java, например -Dfml.ignoreInvalidMinecraftCertificates=true'}" />

                                <TextBlock Text="{l:T 'Окно игры'}" Style="{StaticResource H2}" Margin="0,16,0,6" />
                                <DockPanel>
                                    <ComboBox DockPanel.Dock="Left" Width="170" ItemsSource="{Binding ResolutionPresets}" SelectedItem="{Binding ResolutionPreset}" Margin="0,0,10,0" />
                                    <TextBox Width="80" Text="{Binding Width}" ToolTip="{l:T 'Ширина'}" />
                                    <TextBlock Text="  ×  " VerticalAlignment="Center" />
                                    <TextBox Width="80" Text="{Binding Height}" HorizontalAlignment="Left" ToolTip="{l:T 'Высота'}" />
                                </DockPanel>
                                <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Полноэкранный режим'}" IsChecked="{Binding Fullscreen}" Margin="0,8,0,0" />
                                <CheckBox Style="{StaticResource Toggle}" Content="{l:T 'Использовать дискретную видеокарту'}" IsChecked="{Binding DiscreteGpu}" Margin="0,8,0,0"
                                          Visibility="{Binding ShowDiscreteGpu, Converter={StaticResource VisibleIf}}"
                                          ToolTip="{l:T 'Для ноутбуков с двумя видеокартами: Windows будет запускать Java этой версии на мощной'}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= Java ================= -->
                    <TabItem Header="☕ Java">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,8,8">
                                <TextBlock Style="{StaticResource Muted}"><Run Text="{l:T 'Этой версии игры нужна Java '}" /><Run Text="{Binding RequiredJava, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" /><Run Text="{l:T '. Без выбора лаунчер подберёт её сам.'}" /></TextBlock>
                                <DockPanel Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Авто'}" Command="{Binding UseAutoJavaCommand}" Margin="8,0,0,0" />
                                    <ComboBox ItemsSource="{Binding Runtimes}" SelectedItem="{Binding SelectedRuntime}" DisplayMemberPath="Display" />
                                </DockPanel>
                                <TextBlock Text="{l:T 'Сейчас: автоподбор'}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           Visibility="{Binding SelectedRuntime, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Проверить (java -version)'}" Command="{Binding TestJavaCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource AccentButton}" Content="{l:T 'Скачать нужную Java'}" Command="{Binding DownloadJavaCommand}" />
                                </StackPanel>
                                <Border CornerRadius="8" Padding="10" Margin="0,10,0,0" Background="#C0050910"
                                        Visibility="{Binding JavaTestOutput, Converter={StaticResource VisibleIf}}">
                                    <TextBlock Text="{Binding JavaTestOutput}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,0"
                                           Text="{l:T 'Память (-Xmx/-Xms), сборщик мусора и свои флаги — во вкладке «Производительность».'}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= Моды и паки ================= -->
                    <TabItem Header="{l:T '🧩 Моды и паки'}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,4,8,8">
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource GhostButton}" Content="📁 mods" Command="{Binding OpenFolderCommand}" CommandParameter="mods" Margin="0,0,6,6" />
                                    <Button Style="{StaticResource GhostButton}" Content="📁 resourcepacks" Command="{Binding OpenFolderCommand}" CommandParameter="resourcepacks" Margin="0,0,6,6" />
                                    <Button Style="{StaticResource GhostButton}" Content="📁 shaderpacks" Command="{Binding OpenFolderCommand}" CommandParameter="shaderpacks" Margin="0,0,6,6" />
                                    <Button Style="{StaticResource GhostButton}" Content="📁 saves" Command="{Binding OpenFolderCommand}" CommandParameter="saves" Margin="0,0,6,6" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T '⟳ Обновить списки'}" Command="{Binding RefreshPacksCommand}" Margin="0,0,6,6" />
                                </WrapPanel>

                                <!-- Ресурспаки -->
                                <TextBlock Text="{l:T 'Ресурспаки'}" Style="{StaticResource H2}" Margin="0,4,0,4" />
                                <TextBlock Text="{l:T 'Включённые сверху вниз — по убыванию приоритета: верхний перекрывает нижние.'}" Style="{StaticResource Muted}" FontSize="12" />
                                <TextBlock Text="{l:T 'Ресурспаков нет — положите .zip в папку resourcepacks.'}" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                           Visibility="{Binding ResourcePacks.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                <ItemsControl ItemsSource="{Binding ResourcePacks}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="8,4" Margin="0,2" Background="#10FFFFFF">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource GhostButton}" Content="▲" Padding="8,2" Margin="0,0,4,0"
                                                                Command="{Binding DataContext.MovePackUpCommand, RelativeSource={RelativeSource AncestorType=TabItem}}" CommandParameter="{Binding}" />
                                                        <Button Style="{StaticResource GhostButton}" Content="▼" Padding="8,2"
                                                                Command="{Binding DataContext.MovePackDownCommand, RelativeSource={RelativeSource AncestorType=TabItem}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <CheckBox Style="{StaticResource Check}" Content="{Binding Title}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:T 'Порядок и включение паков применятся после «Сохранить».'}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0" />

                                <!-- Моды -->
                                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,16,0,12" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T '🔍 Каталог модов'}"
                                            Command="{Binding DataContext.ToggleModCatalogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Assets/ui/item_block.png" Height="28" Margin="0,0,10,0" />
                                        <TextBlock Text="{l:T 'Моды'}" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" Text="{l:T 'Нужен модлоадер: создайте версию с Fabric, Quilt, Forge или NeoForge.'}"
                                           Visibility="{Binding DataContext.SelectedHasLoader, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />

                                <Border CornerRadius="12" Padding="12" Margin="0,10,0,0" Background="#140A101E" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                        Visibility="{Binding DataContext.ShowModCatalog, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIf}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Найти'}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.SearchModsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBox Text="{Binding DataContext.ModQuery, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Поиск модов" ToolTip="{l:T 'Например: sodium, jei, create'}" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                    Visibility="{Binding DataContext.IsSearchingMods, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIf}}">
                                            <Image Source="/Assets/ui/loader.png" Height="20" Style="{StaticResource Spinning}" />
                                            <TextBlock Text="{l:T '  Ищем на Modrinth…'}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding DataContext.ModResults, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="10,8" Margin="0,3" Background="#10FFFFFF">
                                                        <DockPanel>
                                                            <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                                <Button Style="{StaticResource AccentButton}" Content="{l:T 'Установить'}" Padding="14,6"
                                                                        Command="{Binding DataContext.InstallModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                                                <TextBlock Text="{l:T '✓ Установлен'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                           Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}}" />
                                                                <Border Background="#E00D1528" CornerRadius="8" Visibility="{Binding IsInstalling, Converter={StaticResource VisibleIf}}">
                                                                    <Image Source="/Assets/ui/loader.png" Height="24" Style="{StaticResource Spinning}" />
                                                                </Border>
                                                            </Grid>
                                                            <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="8" Margin="0,0,10,0" Background="#22FFFFFF">
                                                                <Image Source="{Binding Hit.IconUrl, TargetNullValue=/Assets/ui/item_block.png}" Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel>
                                                                <TextBlock FontWeight="SemiBold">
                                                                    <Run Text="{Binding Hit.Title, Mode=OneWay}" />
                                                                    <Run Text="{Binding DownloadsText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="Normal" />
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Hit.Description}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxHeight="34" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                                   Text="{l:T 'Моды из каталога Modrinth. Обязательные зависимости (например, Fabric API) ставятся автоматически.'}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding DataContext.ModsHint, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                           Visibility="{Binding DataContext.ModsHint, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleIf}}" />
                                <ItemsControl ItemsSource="{Binding DataContext.ModFiles, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="10,6" Margin="0,3" Background="#10FFFFFF">
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" Padding="10,4" ToolTip="{l:T 'Удалить мод'}"
                                                            Command="{Binding DataContext.RemoveModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}" Margin="0,0,8,0"
                                                              ToolTip="{l:T 'Включить / выключить без удаления'}"
                                                              Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                                    <Image DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0"
                                                           Source="{Binding IconUrl, TargetNullValue=/Assets/ui/item_block.png}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" FontSize="11" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ================= Пресеты ================= -->
                    <TabItem Header="{l:T '💾 Пресеты'}">
                        <StackPanel Margin="0,4,8,8">
                            <TextBlock Text="{l:T 'Мои настройки одним файлом'}" Style="{StaticResource H2}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,10"
                                       Text="{l:T 'Графика, звук, управление, RAM и флаги Java — в файл .frogpreset.json. Им можно поделиться с другом или применить к другой версии.'}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="{l:T 'Экспортировать'}" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Импортировать…'}" Command="{Binding ImportCommand}" />
                            </StackPanel>
                            <TextBlock Text="{l:T 'Сброс'}" Style="{StaticResource H2}" Margin="0,22,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Сбросить до рекомендуемых'}" Command="{Binding ResetRecommendedCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource DangerButton}" Content="{l:T 'Сбросить всё'}" Command="{Binding ResetAllCommand}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                       Text="{l:T '«Сбросить всё» удаляет options.txt — Minecraft создаст его заново со стандартными значениями.'}" />
                        </StackPanel>
                    </TabItem>

                    <!-- ================= Миры ================= -->
                    <TabItem Header="{l:T '🌍 Миры'}">
                        <DockPanel DataContext="{Binding Worlds}" Margin="0,4,8,8" AllowDrop="True" Drop="Worlds_Drop" Background="Transparent">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T '📥 Импорт мира'}" Command="{Binding ImportWorldCommand}" />
                                <TextBlock Text="{l:T 'Мир из .zip можно и просто перетащить сюда.'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                                           Text="{l:T 'Автобэкап: раз в сутки для миров, в которых вы играли, — при запуске лаунчера и после выхода из игры. Хранятся 5 последних авто-копий.'}" />
                                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="{l:T '☁ Облачные бэкапы появятся вместе с сервером FrogLauncher — сейчас копии лежат на этом компьютере.'}" />
                            </StackPanel>
                            <Grid>
                                <TextBlock Style="{StaticResource Muted}" Text="{l:T 'В этой версии ещё нет миров — создайте мир в игре, и он появится здесь.'}"
                                           TextWrapping="Wrap" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleIf}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="WorldsList" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="10" Padding="10" Margin="0,0,0,8" Background="#10FFFFFF">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="8" ClipToBounds="True" Background="#20FFFFFF" Margin="0,0,12,0" VerticalAlignment="Top">
                                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                        </Border>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Info.Name}" Style="{StaticResource H2}" />
                                                            <TextBlock Text="{Binding Info.Summary}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                                                            <WrapPanel Margin="0,8,0,0">
                                                                <Button Style="{StaticResource AccentButton}" Content="{l:T 'Бэкап'}" Margin="0,0,6,4" Padding="12,5"
                                                                        Command="{Binding DataContext.BackupCommand, ElementName=WorldsList}" CommandParameter="{Binding}" />
                                                                <ComboBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" DisplayMemberPath="Title"
                                                                          MinWidth="210" Margin="0,0,6,4" Visibility="{Binding Backups.Count, Converter={StaticResource VisibleIf}}" />
                                                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Восстановить'}" Margin="0,0,6,4" Padding="12,5"
                                                                        Visibility="{Binding Backups.Count, Converter={StaticResource VisibleIf}}"
                                                                        Command="{Binding DataContext.RestoreCommand, ElementName=WorldsList}" CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Экспорт .zip'}" Margin="0,0,6,4" Padding="12,5"
                                                                        Command="{Binding DataContext.ExportCommand, ElementName=WorldsList}" CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Папка'}" Margin="0,0,6,4" Padding="12,5"
                                                                        Command="{Binding DataContext.OpenFolderCommand, ElementName=WorldsList}" CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource DangerButton}" Content="{l:T 'Удалить'}" Margin="0,0,6,4" Padding="12,5"
                                                                        Command="{Binding DataContext.DeleteCommand, ElementName=WorldsList}" CommandParameter="{Binding}" />
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
