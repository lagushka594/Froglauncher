<UserControl x:Class="FrogLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FrogLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Баннер для Tadpole («реклама» = наш собственный промо-блок, без сторонних сетей). -->
        <Button Grid.Row="0" Style="{StaticResource ImageButton}" Command="{Binding OpenSubscriptionCommand}" Margin="0,0,0,10"
                Visibility="{Binding ShowAdBanner, Converter={StaticResource VisibleIf}}" HorizontalAlignment="Stretch">
            <Border CornerRadius="12" Padding="14,10" BorderThickness="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3322C55E" Offset="0" />
                        <GradientStop Color="#33F59E0B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#22C55E" Offset="0" />
                        <GradientStop Color="#F59E0B" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Сравнить тарифы →" Foreground="#FDE68A" FontWeight="Bold" VerticalAlignment="Center" />
                    <Image Source="/Assets/ui/frog_king.png" Height="34" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Подписка FrogLauncher: без рекламы, больше версий, премиум-темы и облачные бэкапы" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Text="Игра бесплатна всегда — подписка лишь добавляет удобства лаунчера." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Button>

        <!-- Центр: логотип и маскот. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <Image Source="/Assets/main/logo.png" Height="200" HorizontalAlignment="Left" Style="{StaticResource Floating}" />
                <TextBlock Text="Квакнем по-крупному 🐸" Style="{StaticResource H2}" Margin="0,12,0,0" />
                <TextBlock Text="Ванилла, Fabric, Quilt, Forge и NeoForge — в один клик." Style="{StaticResource Muted}" />
            </StackPanel>

            <!-- Крэш: последние 50 строк + mclo.gs. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="470" VerticalAlignment="Stretch" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource DangerBrush}" Visibility="{Binding Crash, Converter={StaticResource VisibleIf}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="/Assets/installer/icon_error.png" Height="28" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center">
                            <Run Text="Игра упала · код " /><Run Text="{Binding Crash.ExitCode, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Style="{StaticResource AccentButton}" Content="Загрузить на mclo.gs" Command="{Binding UploadCrashCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="Копировать" Command="{Binding CopyCrashCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource LinkButton}" Content="{Binding MclogsUrl}" Command="{Binding OpenMclogsCommand}" VerticalAlignment="Center"
                                Visibility="{Binding MclogsUrl, Converter={StaticResource VisibleIf}}" />
                    </WrapPanel>
                    <Border Background="#C0050910" CornerRadius="8" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Crash.LastLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Нижняя панель: инстанс, аккаунт, прогресс, Играть/Стоп. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{Binding Mascot}" Height="62" Margin="0,0,14,0" Style="{StaticResource Floating}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Версия" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Margin="0,4,0,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/main/icon_version.png" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayVersion}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0"
                            Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="/Assets/main/loader.png" Height="22" Margin="0,0,8,0" Style="{StaticResource Spinning}" />
                        <TextBlock Text="{Binding Progress.Stage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Margin="0,6" />
                    <TextBlock Text="{Binding Progress.Details}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/ui/status_online.png" Height="24" />
                        <TextBlock Text="  Игра запущена — приятной игры!" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastLogLine}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerButton}" Content="■  Стоп" Command="{Binding StopCommand}" Margin="0,0,12,0" Height="44"
                            Visibility="{Binding ShowStop, Converter={StaticResource VisibleIf}}" />
                    <Button x:Name="PlayButton" Style="{StaticResource ImageButton}" Command="{Binding PlayCommand}" ToolTip="Играть">
                        <Grid>
                            <Image x:Name="PlayIdle" Source="/Assets/main/btn_play.png" Height="78" />
                            <Image Source="/Assets/main/btn_play_hover.png" Height="78"
                                   Visibility="{Binding IsMouseOver, ElementName=PlayButton, Converter={StaticResource VisibleIf}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
