<Window x:Class="FrogLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrogLauncher.ViewModels"
        xmlns:v="clr-namespace:FrogLauncher.Views"
        Title="FrogLauncher" Width="1180" Height="740" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Icon="/Assets/ui/icon_frog.ico"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:EnumEqualsConverter x:Key="EnumEq" />
        <v:VisibleIfConverter x:Key="VisibleIf" />

        <!-- Каждой странице (ViewModel) — своё представление. -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstancesViewModel}"><v:InstancesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModpacksViewModel}"><v:ModpacksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JavaViewModel}"><v:JavaView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><v:ProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubscriptionViewModel}"><v:SubscriptionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Фон: ночное болото + затемнение для читаемости. -->
        <Image Source="/Assets/main/bg.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F00B1220" Offset="0" />
                    <GradientStop Color="#C00B1220" Offset="0.45" />
                    <GradientStop Color="#900B1220" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Боковое меню ===== -->
            <Border Grid.Column="0" Background="#B3080D18" BorderBrush="{StaticResource FrameGradient}" BorderThickness="0,0,1.5,0">
                <DockPanel LastChildFill="False" Margin="10,12">
                    <Image DockPanel.Dock="Top" Source="/Assets/ui/logo_text.png" Height="78" Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Главная"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Home}">
                            <Image Source="/Assets/ui/btn_home.png" Height="64" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Каталог: версии и модлоадеры"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Catalog}">
                            <Image Source="/Assets/ui/btn_catalog.png" Height="58" />
                        </RadioButton>
                        <!-- Сборки Modrinth: в атласе нет готовой кнопки — собираем из item_block. -->
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Сборки с Modrinth"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Modpacks}">
                            <Border Width="94" Height="52" CornerRadius="10" BorderThickness="2" Background="#CC0A1A12">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22C55E" Offset="0" />
                                        <GradientStop Color="#06B6D4" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="/Assets/ui/item_block.png" Height="22" />
                                    <TextBlock Text="Сборки" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#A7F3D0" />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Java"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Java}">
                            <Image Source="/Assets/ui/btn_java.png" Height="58" />
                        </RadioButton>

                        <!-- 👑 Подписка: в атласе нет готовой кнопки — собираем из frog_king. -->
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Подписка"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Subscription}">
                            <Border Width="94" Height="62" CornerRadius="10" BorderThickness="2" Background="#CC1A1305">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="/Assets/ui/frog_king.png" Height="30" />
                                    <TextBlock Text="Подписка" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#FDE68A" />
                                </StackPanel>
                            </Border>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Профиль и аккаунты"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Profile}">
                            <Image Source="/Assets/ui/btn_profile.png" Height="58" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Настройки"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Settings}">
                            <Image Source="/Assets/ui/btn_settings.png" Height="58" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Помощь и о лаунчере"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Help}">
                            <Image Source="/Assets/ui/btn_help.png" Height="58" />
                        </RadioButton>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ImageButton}" Command="{Binding ExitCommand}" ToolTip="Выход"
                            HorizontalAlignment="Center">
                        <Image Source="/Assets/ui/btn_exit.png" Height="54" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- ===== Правая часть ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок окна: ник + бейдж ADMIN + тир, кнопки окна. -->
                <DockPanel Grid.Row="0" Margin="18,0,8,0">
                    <Grid DockPanel.Dock="Right" Width="124" Height="38" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Image Source="/Assets/ui/window_controls.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <UniformGrid Columns="3">
                            <Button Opacity="0" Cursor="Hand" ToolTip="Свернуть" Click="Minimize_Click" />
                            <Button Opacity="0" Cursor="Hand" ToolTip="Развернуть" Click="Maximize_Click" />
                            <Button Opacity="0" Cursor="Hand" ToolTip="Закрыть" Click="Close_Click" />
                        </UniformGrid>
                    </Grid>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/ui/avatar.png" Width="34" Height="34" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource AdminBadge}" Margin="10,0,0,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="ADMIN" FontWeight="Black" FontSize="11" Foreground="White" />
                        </Border>
                        <Border Margin="10,0,0,0" CornerRadius="6" Padding="8,2" Background="#22FFFFFF" VerticalAlignment="Center"
                                Visibility="{Binding IsAdmin, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding TierName}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Баннеры статуса подписки (не блокируют игру). -->
                <StackPanel Grid.Row="1" Margin="18,0,18,6">
                    <Border CornerRadius="10" Padding="14,8" Margin="0,0,0,6" Background="#33F59E0B" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                            Visibility="{Binding GraceBanner, Converter={StaticResource VisibleIf}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Продлить"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Subscription}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/ui/frog_sad.png" Height="26" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding GraceBanner}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="14,6" Background="#223B82F6" BorderBrush="#3B82F6" BorderThickness="1"
                            Visibility="{Binding VerificationFailed, Converter={StaticResource VisibleIf}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/installer/icon_info.png" Height="20" Margin="0,0,10,0" />
                            <TextBlock Text="Не удалось проверить подписку — работаем по сохранённым данным (до 7 дней)." VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="18,0,18,18" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Тосты. -->
        <ItemsControl ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,8,0,0" MaxWidth="420" Background="#F2111A2E">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="60" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Height="34" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
