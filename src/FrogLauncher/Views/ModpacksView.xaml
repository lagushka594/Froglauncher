<UserControl x:Class="FrogLauncher.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:FrogLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <DockPanel>
            <!-- Заголовок и фильтры -->
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/ui/item_block.png" Height="44" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Сборки" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="Готовые модпаки с Modrinth: версия игры, модлоадер, моды и настройки ставятся одним кликом." />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск сборок"
                             ToolTip="Например: optimized, create, skyblock" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding SelectedLoader}" Margin="8,0,0,0" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding GameVersions}" SelectedItem="{Binding SelectedVersion}" Margin="8,0,0,0"
                              MaxDropDownHeight="320" />
                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="Найти" Command="{Binding SearchCommand}" Margin="8,0,0,0" IsDefault="True" />
                </Grid>

                <!-- Лимит версий -->
                <Border CornerRadius="10" Padding="12" Margin="0,10,0,0" Background="#22F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                        Visibility="{Binding Upsell, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Сравнить" Command="{Binding CompareCommand}" />
                        <Image Source="/Assets/ui/frog_surprise.png" Height="28" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Upsell}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- Прогресс установки -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="/Assets/main/loader.png" Height="22" Margin="0,0,8,0" Style="{StaticResource Spinning}" />
                        <TextBlock Text="{Binding Progress.Stage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Margin="0,6" />
                    <TextBlock Text="{Binding Progress.Details}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsSearching, Converter={StaticResource VisibleIf}}">
                    <Image Source="/Assets/ui/loader.png" Height="20" Style="{StaticResource Spinning}" />
                    <TextBlock Text="  Ищем на Modrinth…" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <!-- Результаты -->
            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="12,10" Margin="0,4" Background="#10FFFFFF">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="Modrinth ↗" Margin="0,0,8,0" Padding="10,6"
                                                    Command="{Binding DataContext.OpenOnModrinthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Grid>
                                                <Button Style="{StaticResource AccentButton}" Content="Установить" Padding="16,7"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                                <TextBlock Text="✓ Установлена" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}}" />
                                                <Border Background="#E00D1528" CornerRadius="9" Visibility="{Binding IsInstalling, Converter={StaticResource VisibleIf}}">
                                                    <Image Source="/Assets/ui/loader.png" Height="26" Style="{StaticResource Spinning}" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="10" Margin="0,0,12,0" Background="#22FFFFFF" ClipToBounds="True">
                                            <Image Source="{Binding Hit.IconUrl, TargetNullValue=/Assets/ui/item_block.png}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="15">
                                                <Run Text="{Binding Hit.Title, Mode=OneWay}" />
                                                <Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" FontSize="12" FontWeight="Normal" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Hit.Description}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                <Run Text="{Binding DownloadsText, Mode=OneWay}" /><Run Text=" · автор " /><Run Text="{Binding Hit.Author, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Content="Показать ещё" HorizontalAlignment="Center" Margin="0,10"
                            Command="{Binding LoadMoreCommand}" Visibility="{Binding CanLoadMore, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Text="Сборки и моды — с Modrinth (modrinth.com). Права на сборки принадлежат их авторам." />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
