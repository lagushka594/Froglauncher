<UserControl x:Class="FrogLauncher.Views.JavaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:FrogLauncher.Core"
             xmlns:v="clr-namespace:FrogLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
    </UserControl.Resources>
    <Border Style="{StaticResource Card}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Image Source="/Assets/ui/java.png" Height="54" Margin="0,0,14,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T '⟳ Найти заново'}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Java" Style="{StaticResource H1}" />
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{l:T 'Нужная версия подбирается автоматически: до 1.16 — Java 8, 1.17–1.20.4 — Java 17, с 1.20.5 — Java 21. Ручной выбор — в настройках версии в «Каталоге».'}" />
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
                <TextBlock Text="{l:T 'Скачать Eclipse Temurin:'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Style="{StaticResource AccentButton}" Content="Java 8" Command="{Binding DownloadCommand}" CommandParameter="8" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Content="Java 17" Command="{Binding DownloadCommand}" CommandParameter="17" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Content="Java 21" Command="{Binding DownloadCommand}" CommandParameter="21" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0" Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="{Binding Progress.Stage}" FontWeight="SemiBold" />
                <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Margin="0,6" />
                <TextBlock Text="{Binding Progress.Details}" Style="{StaticResource Muted}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Runtimes}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="10" Padding="12,8" Margin="0,3" Background="#10FFFFFF">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Source}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"><Run Text="Java " /><Run Text="{Binding Major, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Text="{Binding JavaExe}" Style="{StaticResource Muted}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</UserControl>
