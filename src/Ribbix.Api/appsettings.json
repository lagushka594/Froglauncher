{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ribbix": "Host=localhost;Port=5432;Database=ribbix;Username=ribbix"
  },
  "Jwt": {
    "Issuer": "frog-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "ServiceTokenMinutes": 15
  },
  "Billing": {
    "DefaultProvider": "manual",
    "PublicBaseUrl": "https://api.ribbix.example",
    "GraceDays": 7,
    "RenewalLeadHours": 24,
    "MaxRenewalAttempts": 3
  },
  "YooKassa": {
    "ApiBase": "https://api.yookassa.ru/v3/",
    "EnforceIpAllowlist": true
  },
  "Paddle": {
    "ApiBase": "https://api.paddle.com/",
    "Prices": {
      "ribbix_lite:month": "", "ribbix_lite:year": "",
      "ribbix_plus:month": "", "ribbix_plus:year": "",
      "ribbix_pro:month": "", "ribbix_pro:year": "",
      "ribbix_legend:month": "", "ribbix_legend:year": ""
    }
  },
  "KnownProxies": []
}
