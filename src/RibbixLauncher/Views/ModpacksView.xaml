<UserControl x:Class="RibbixLauncher.Views.ModpacksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RibbixLauncher.Core"
             xmlns:v="clr-namespace:RibbixLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
    </UserControl.Resources>

    <v:PixelBorder Style="{StaticResource Card}">
        <DockPanel>
            <!-- Заголовок и фильтры -->
            <StackPanel DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource IconTile}" Tag="modpack" Foreground="#A78BFA" Width="52" Height="52" FontSize="30" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Каталог Modrinth'}" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Muted}"
                                   Text="{l:T 'Сборки, моды, ресурспаки, шейдеры и датапаки — выберите, что искать и в какую версию поставить.'}" />
                    </StackPanel>
                </StackPanel>

                <!-- Что ищем. -->
                <ItemsControl ItemsSource="{Binding Kinds}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource Segment}" GroupName="kind" Margin="0,0,6,6"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}" Checked="Kind_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <v:PixelIcon Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Куда ставим (для всего, кроме сборок). -->
                <WrapPanel Margin="0,4,0,0" Visibility="{Binding IsModpacks, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                    <TextBlock Text="{l:T 'Скачать в версию'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="260" Margin="0,0,16,0" AutomationProperties.Name="Версия">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" · " Foreground="{DynamicResource MutedBrush}" /><Run Text="{Binding DisplayVersion, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDatapacks, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{l:T 'мир'}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding TargetWorlds}" SelectedItem="{Binding TargetWorld}" MinWidth="200" AutomationProperties.Name="Мир" />
                    </StackPanel>
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Поиск"
                             ToolTip="{l:T 'Например: optimized, sodium, faithful, complementary'}" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding SelectedLoader}" Margin="8,0,0,0"
                              Visibility="{Binding IsModpacks, Converter={StaticResource VisibleIf}}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding GameVersions}" SelectedItem="{Binding SelectedVersion}" Margin="8,0,0,0"
                              MaxDropDownHeight="320" Visibility="{Binding IsModpacks, Converter={StaticResource VisibleIf}}" />
                    <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="{l:T 'Найти'}" Command="{Binding SearchCommand}" Margin="8,0,0,0" IsDefault="True" />
                </Grid>

                <!-- Лимит версий -->
                <v:PixelBorder CornerRadius="10" Padding="12" Margin="0,10,0,0" Background="#22F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                        Visibility="{Binding Upsell, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Сравнить'}" Command="{Binding CompareCommand}" />
                        <Image Source="/Assets/ui/frog_surprise.png" Height="28" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Upsell}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </v:PixelBorder>

                <!-- Прогресс установки -->
                <StackPanel Margin="0,12,0,0" Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="/Assets/main/loader.png" Height="22" Margin="0,0,8,0" Style="{StaticResource Spinning}" />
                        <TextBlock Text="{Binding Progress.Stage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Margin="0,6" />
                    <TextBlock Text="{Binding Progress.Details}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsSearching, Converter={StaticResource VisibleIf}}">
                    <Image Source="/Assets/ui/loader.png" Height="20" Style="{StaticResource Spinning}" />
                    <TextBlock Text="{l:T '  Ищем на Modrinth…'}" Style="{StaticResource Muted}" />
                </StackPanel>
            </StackPanel>

            <!-- Результаты -->
            <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <v:PixelBorder CornerRadius="12" Padding="12,10" Margin="0,4" Background="#10FFFFFF">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="Modrinth ↗" Margin="0,0,8,0" Padding="10,6"
                                                    Command="{Binding DataContext.OpenOnModrinthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Grid>
                                                <Button Style="{StaticResource AccentButton}" Content="{l:T 'Установить'}" Padding="16,7"
                                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                                                <TextBlock Text="{l:T '✓ Установлена'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource VisibleIf}}" />
                                                <v:PixelBorder Background="#E00D1528" CornerRadius="9" Visibility="{Binding IsInstalling, Converter={StaticResource VisibleIf}}">
                                                    <Image Source="/Assets/ui/loader.png" Height="26" Style="{StaticResource Spinning}" />
                                                </v:PixelBorder>
                                            </Grid>
                                        </StackPanel>
                                        <v:PixelBorder DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="10" Margin="0,0,12,0" Background="#22FFFFFF" ClipToBounds="True">
                                            <Image Source="{Binding Hit.IconUrl, TargetNullValue=/Assets/ui/item_block.png}" Stretch="UniformToFill" />
                                        </v:PixelBorder>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" FontSize="15">
                                                <Run Text="{Binding Hit.Title, Mode=OneWay}" />
                                                <Run Text="{Binding Meta, Mode=OneWay}" Foreground="{DynamicResource Accent2Brush}" FontSize="12" FontWeight="Normal" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Hit.Description}" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxHeight="36" />
                                            <TextBlock Style="{StaticResource Muted}" FontSize="11">
                                                <Run Text="{Binding DownloadsText, Mode=OneWay}" /><Run Text="{l:T ' · автор '}" /><Run Text="{Binding Hit.Author, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </v:PixelBorder>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Показать ещё'}" HorizontalAlignment="Center" Margin="0,10"
                            Command="{Binding LoadMoreCommand}" Visibility="{Binding CanLoadMore, Converter={StaticResource VisibleIf}}" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Text="{l:T 'Сборки и моды — с Modrinth (modrinth.com). Права на сборки принадлежат их авторам.'}" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </v:PixelBorder>
</UserControl>
