<UserControl x:Class="RibbixLauncher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:RibbixLauncher.Views"
             xmlns:l="clr-namespace:RibbixLauncher.Core"
             Style="{StaticResource Page}">
    <v:PixelBorder Style="{StaticResource Card}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/ui/mascot_big.png" Height="190" VerticalAlignment="Top" Margin="0,0,24,0" Style="{StaticResource Floating}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{l:T 'О лаунчере'}" Style="{StaticResource H1}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"><Run Text="Ribbix Launcher " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>

                <TextBlock TextWrapping="Wrap" Margin="0,16,0,0" FontSize="14"
                           Text="{l:T 'Ribbix — неофициальный лаунчер Minecraft с открытым исходным кодом. Не является продуктом Mojang или Microsoft и не одобрен ими. Minecraft — товарный знак Mojang AB.'}" />
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" FontSize="14"
                           Text="{l:T 'Игра запускается на любом тарифе. Подписка даёт доступ только к функциям Ribbix и не связана с Mojang/Microsoft.'}" />

                <!-- Соцсети и исходный код. -->
                <TextBlock Text="{l:T 'Мы в сети'}" Style="{StaticResource H2}" Margin="0,22,0,8" />
                <WrapPanel>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenDiscordCommand}" Margin="0,0,8,8" BorderBrush="#5865F2">
                        <StackPanel Orientation="Horizontal">
                            <v:PixelIcon Kind="chat" Foreground="#8B9BFF" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="Discord" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenTikTokCommand}" Margin="0,0,8,8" BorderBrush="#EE1D52">
                        <StackPanel Orientation="Horizontal">
                            <v:PixelIcon Kind="note" Foreground="#69C9D0" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="TikTok" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenYouTubeCommand}" Margin="0,0,8,8" BorderBrush="#FF0033">
                        <StackPanel Orientation="Horizontal">
                            <v:PixelIcon Kind="video" Foreground="#FF4D6D" Accent="#FFFFFF" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="YouTube" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding OpenGitHubCommand}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <v:PixelIcon Kind="code" Foreground="#E7F8EC" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{l:T 'Исходный код на GitHub'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Папка логов'}" Command="{Binding OpenLogsCommand}" Margin="0,0,8,8" />
                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Пройти знакомство заново'}" Command="{Binding ShowOnboardingCommand}" Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock Text="{l:T 'Горячие клавиши'}" Style="{StaticResource H2}" Margin="0,24,0,4" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="{l:T 'Ctrl+Enter — играть · Ctrl+N — новая версия · Ctrl+K — поиск · F5 — обновить · Ctrl+, — настройки · Ctrl+Shift+M — свернуть и играть. Переназначить — в «Настройках».'}" />

                <TextBlock Text="{l:T 'Если игра упала'}" Style="{StaticResource H2}" Margin="0,24,0,4" />
                <TextBlock Style="{StaticResource Muted}"
                           Text="{l:T 'На главной откроется «Доктор крашей»: причина простыми словами и кнопки починки. Если не помогло — «Найти мод-виновника» или «Загрузить на mclo.gs» и ссылку в наш Discord.'}" />
            </StackPanel>
        </Grid>
    </v:PixelBorder>
</UserControl>
