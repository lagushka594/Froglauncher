<Window x:Class="RibbixLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RibbixLauncher.Core"
        xmlns:vm="clr-namespace:RibbixLauncher.ViewModels"
        xmlns:v="clr-namespace:RibbixLauncher.Views"
        Title="Ribbix Launcher" Width="1180" Height="740" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Icon="/Assets/ui/icon_frog.ico"
        FontFamily="{StaticResource UiFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <v:EnumEqualsConverter x:Key="EnumEq" />
        <v:VisibleIfConverter x:Key="VisibleIf" />

        <!-- Каждой странице (ViewModel) — своё представление. -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InstancesViewModel}"><v:InstancesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModpacksViewModel}"><v:ModpacksView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}"><v:ServersView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JavaViewModel}"><v:JavaView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><v:ProfileView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SubscriptionViewModel}"><v:SubscriptionView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Фон: ночное болото + затемнение для читаемости. -->
        <Image Source="/Assets/main/bg.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F00B1220" Offset="0" />
                    <GradientStop Color="#C00B1220" Offset="0.45" />
                    <GradientStop Color="#900B1220" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Боковое меню ===== -->
            <Border Grid.Column="0" Background="#B3080D18" BorderBrush="{StaticResource FrameGradient}" BorderThickness="0,0,1.5,0">
                <DockPanel LastChildFill="False" Margin="10,12">
                    <Image DockPanel.Dock="Top" Source="/Assets/ui/logo_text.png" Height="58" Margin="0,0,0,8"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Главная'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Home}">
                            <v:ArtLabel Source="/Assets/ui/btn_home.png" Height="46" Label="Главная" LabelColor="#A3D77E" LabelArea="0.14,0.62,0.72,0.24" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Каталог: версии и модлоадеры'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Catalog}">
                            <v:ArtLabel Source="/Assets/ui/btn_catalog.png" Height="44" Label="Каталог" LabelColor="#11CFDB" LabelArea="0.19,0.61,0.70,0.25" />
                        </RadioButton>
                        <!-- Сборки Modrinth: в атласе нет готовой кнопки — собираем из item_block. -->
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Сборки с Modrinth'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Modpacks}">
                            <Border Width="94" Height="46" CornerRadius="10" BorderThickness="2" Background="#CC0A1A12">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#22C55E" Offset="0" />
                                        <GradientStop Color="#06B6D4" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="/Assets/ui/item_block.png" Height="18" />
                                    <TextBlock Text="{l:T 'Сборки'}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#A7F3D0" />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <!-- Серверы -->
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Серверы: онлайн и быстрый вход'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Servers}">
                            <Border Width="94" Height="46" CornerRadius="10" BorderThickness="2" Background="#CC0A1220">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#06B6D4" Offset="0" />
                                        <GradientStop Color="#3B82F6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="/Assets/ui/biome_icon.png" Height="18" />
                                    <TextBlock Text="{l:T 'Серверы'}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#A5F3FC" />
                                </StackPanel>
                            </Border>
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="Java"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Java}">
                            <Image Source="/Assets/ui/btn_java.png" Height="44" />
                        </RadioButton>

                        <!-- 👑 Подписка: в атласе нет готовой кнопки — собираем из frog_king. -->
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Подписка'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Subscription}">
                            <Border Width="94" Height="46" CornerRadius="10" BorderThickness="2" Background="#CC1A1305">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#F59E0B" Offset="0" />
                                        <GradientStop Color="#8B5CF6" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="/Assets/ui/frog_king.png" Height="20" />
                                    <TextBlock Text="{l:T 'Подписка'}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#FDE68A" />
                                </StackPanel>
                            </Border>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Профиль и аккаунты'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Profile}">
                            <v:ArtLabel Source="/Assets/ui/btn_profile.png" Height="44" Label="Профиль" LabelColor="#C8BCD8" LabelArea="0.19,0.60,0.69,0.26" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Настройки'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Settings}">
                            <v:ArtLabel Source="/Assets/ui/btn_settings.png" Height="44" Label="Настройки" LabelColor="#A2D377" LabelArea="0.18,0.61,0.70,0.25" />
                        </RadioButton>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" ToolTip="{l:T 'Помощь и о лаунчере'}"
                                     IsChecked="{Binding SelectedPage, Converter={StaticResource EnumEq}, ConverterParameter=Help}">
                            <v:ArtLabel Source="/Assets/ui/btn_help.png" Height="44" Label="Помощь" LabelColor="#A3C0D2" LabelArea="0.18,0.64,0.70,0.23" />
                        </RadioButton>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ImageButton}" Command="{Binding ExitCommand}" ToolTip="{l:T 'Выход'}"
                            HorizontalAlignment="Center">
                        <v:ArtLabel Source="/Assets/ui/btn_exit.png" Height="42" Label="Выход" LabelColor="#E769A3" LabelArea="0.21,0.63,0.68,0.24" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- ===== Правая часть ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Заголовок окна: ник + бейдж ADMIN + тир, кнопки окна. -->
                <DockPanel Grid.Row="0" Margin="18,0,8,0">
                    <Grid DockPanel.Dock="Right" Width="124" Height="38" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Image Source="/Assets/ui/window_controls.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        <UniformGrid Columns="3">
                            <Button Opacity="0" Cursor="Hand" ToolTip="{l:T 'Свернуть'}" Click="Minimize_Click" />
                            <Button Opacity="0" Cursor="Hand" ToolTip="{l:T 'Развернуть'}" Click="Maximize_Click" />
                            <Button Opacity="0" Cursor="Hand" ToolTip="{l:T 'Закрыть'}" Click="Close_Click" />
                        </UniformGrid>
                    </Grid>

                    <!-- Командная палитра: та же, что по Ctrl+K. -->
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Margin="0,0,12,0" Padding="12,5" VerticalAlignment="Center"
                            Command="{Binding OpenPaletteCommand}" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Палитра" ToolTip="{l:T 'Командная палитра (поиск всего)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T '🔎 Поиск'}" />
                            <TextBlock Text="  Ctrl+K" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/ui/avatar.png" Width="34" Height="34" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Style="{StaticResource AdminBadge}" Margin="10,0,0,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource VisibleIf}}">
                            <TextBlock Text="ADMIN" FontWeight="Black" FontSize="11" Foreground="White" />
                        </Border>
                        <Border Margin="10,0,0,0" CornerRadius="6" Padding="8,2" Background="#22FFFFFF" VerticalAlignment="Center"
                                Visibility="{Binding IsAdmin, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                            <TextBlock Text="{Binding TierName}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Баннеры статуса подписки (не блокируют игру). -->
                <StackPanel Grid.Row="1" Margin="18,0,18,6">
                    <Border CornerRadius="10" Padding="14,8" Margin="0,0,0,6" Background="#2222C55E" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                            Visibility="{Binding UpdateBanner, Converter={StaticResource VisibleIf}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource GhostButton}" Content="{l:T 'Позже'}" Command="{Binding SkipUpdateCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource AccentButton}" Content="{l:T 'Обновить и перезапустить'}" Command="{Binding ApplyUpdateCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/ui/frog_happy.png" Height="26" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding UpdateBanner}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="14,8" Margin="0,0,0,6" Background="#33F59E0B" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                            Visibility="{Binding GraceBanner, Converter={StaticResource VisibleIf}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Продлить'}"
                                    Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:Page.Subscription}" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="/Assets/ui/frog_sad.png" Height="26" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding GraceBanner}" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border CornerRadius="10" Padding="14,6" Background="#223B82F6" BorderBrush="#3B82F6" BorderThickness="1"
                            Visibility="{Binding VerificationFailed, Converter={StaticResource VisibleIf}}">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/installer/icon_info.png" Height="20" Margin="0,0,10,0" />
                            <TextBlock Text="{l:T 'Не удалось проверить подписку — работаем по сохранённым данным (до 7 дней).'}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="18,0,18,18" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Сезонные эффекты (клики проходят насквозь) -->
        <v:SeasonEffects Season="{Binding Season}" Paused="{Binding EffectsPaused}" />

        <!-- Новогодний фейерверк -->
        <Grid Visibility="{Binding FireworksVisible, Converter={StaticResource VisibleIf}}" Background="Transparent" Cursor="Hand">
            <Grid.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding HideFireworksCommand}" />
            </Grid.InputBindings>
            <v:FireworksView />
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60" IsHitTestVisible="False">
                <TextBlock Text="{l:T 'С Новым годом! 🎆🐸'}" FontSize="40" FontWeight="Black" Foreground="#FACC15" HorizontalAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect Color="#DC2626" BlurRadius="24" ShadowDepth="0" /></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="{l:T 'Щёлкните, чтобы закрыть'}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>

        <!-- Командная палитра (Ctrl+K) -->
        <Grid DataContext="{Binding Palette}" Visibility="{Binding IsOpen, Converter={StaticResource VisibleIf}}">
            <Rectangle Fill="#99070B14" MouseDown="PaletteBackdrop_MouseDown" />
            <Border Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,70,0,0" Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="PaletteBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="34,9,10,9"
                                 AutomationProperties.Name="Командная палитра" PreviewKeyDown="PaletteBox_PreviewKeyDown" />
                        <TextBlock Text="🔎" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Text="{l:T 'Версии, моды, настройки, действия…'}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Style="{StaticResource Muted}" Visibility="{Binding Query, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                    </Grid>
                    <ListBox x:Name="PaletteList" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Margin="0,8,0,0" MaxHeight="430" HorizontalContentAlignment="Stretch"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseUp="PaletteList_MouseUp" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,3">
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="7,1" Background="#18FFFFFF" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CategoryText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Width="28" FontSize="15" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Subtitle, Converter={StaticResource VisibleIf}}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Margin="4,6,4,0">
                        <TextBlock DockPanel.Dock="Right" Text="{l:T 'Ищем моды на Modrinth…'}" FontSize="11" Style="{StaticResource Muted}"
                                   Visibility="{Binding IsSearchingMods, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{l:T '↑↓ — выбор · Enter — выполнить · Esc — закрыть'}" FontSize="11" Style="{StaticResource Muted}" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Онбординг первого запуска -->
        <Grid DataContext="{Binding Onboarding}" Visibility="{Binding IsVisible, Converter={StaticResource VisibleIf}}">
            <Rectangle Fill="#E6070B14" />
            <Border Width="660" MinHeight="440" VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource Card}" Padding="28,22">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{l:T 'Пропустить'}" Command="{Binding SkipCommand}" />
                        <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Muted}" />
                    </DockPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource ImageButton}" Command="{Binding BackCommand}"
                                Visibility="{Binding CanBack, Converter={StaticResource VisibleIf}}">
                            <Image Source="/Assets/ui/btn_back.png" Height="46" />
                        </Button>
                        <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource AccentButton}" Content="{Binding NextText}"
                                Command="{Binding NextCommand}" FontSize="16" Padding="26,11" IsDefault="True" />
                    </DockPanel>

                    <Grid>
                        <!-- Шаги онбординга: содержимое по номеру шага -->
                        <ContentControl Focusable="False">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Step}" Value="0">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Image Source="/Assets/ui/mascot_big.png" Height="150" Style="{StaticResource Floating}" />
                                                        <TextBlock Text="{l:T 'Привет! Я лягушка Ribbix 🐸'}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" Margin="0,8,0,0"
                                                                   Text="{l:T 'За минуту настроим всё для игры: ник, память и рекомендуемую версию Minecraft. Можно пропустить и сделать позже.'}" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Step}" Value="1">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Image Source="/Assets/main/avatar.png" Height="100" />
                                                        <TextBlock Text="{l:T 'Как тебя зовут в игре?'}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Text="{l:T '3–16 символов: латиница, цифры и _. Лицензию Microsoft можно подключить позже в «Профиле».'}" />
                                                        <TextBox Text="{Binding Nick, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,16,0,0" FontSize="18"
                                                                 HorizontalContentAlignment="Center" AutomationProperties.Name="Ник" />
                                                        <TextBlock Text="{Binding NickError}" Foreground="#FCA5A5" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Step}" Value="2">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Image Source="/Assets/main/btn_settings.png" Height="90" />
                                                        <TextBlock Text="{l:T 'Сколько памяти дать игре?'}" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                                        <TextBlock Text="{Binding RamHint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding RamText}" FontSize="34" FontWeight="Black" HorizontalAlignment="Center" Margin="0,14,0,0"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <Slider Minimum="1024" Maximum="{Binding MaxRamMb}" TickFrequency="512" IsSnapToTickEnabled="True"
                                                                Value="{Binding RamMb}" Width="420" />
                                                        <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="12" Margin="0,6,0,0"
                                                                   Text="{l:T 'Больше — не всегда лучше: оставьте системе хотя бы 2–4 ГБ. Поменять можно в настройках версии.'}" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Step}" Value="3">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Image Source="/Assets/main/icon_version.png" Height="90" />
                                                        <TextBlock Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,10,0,0">
                                                            <Run Text="{l:T 'Ставим Minecraft '}" /><Run Text="{Binding LatestVersion, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <StackPanel HorizontalAlignment="Center" Margin="0,14,0,0">
                                                            <RadioButton GroupName="ob" IsChecked="{Binding Optimized}" Foreground="{DynamicResource TextBrush}" Margin="0,4" Cursor="Hand">
                                                                <TextBlock><Run Text="{l:T 'Оптимизированная'}" FontWeight="SemiBold" /><Run Text="{l:T ' — Fabric + Sodium, заметно больше FPS (рекомендуем)'}" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                                                            </RadioButton>
                                                            <RadioButton GroupName="ob" Foreground="{DynamicResource TextBrush}" Margin="0,4" Cursor="Hand">
                                                                <TextBlock><Run Text="{l:T 'Ванильная'}" FontWeight="SemiBold" /><Run Text="{l:T ' — чистая игра без модов'}" Foreground="{DynamicResource MutedBrush}" /></TextBlock>
                                                            </RadioButton>
                                                        </StackPanel>
                                                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}">
                                                            <TextBlock Text="{Binding Progress.Stage}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                            <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Margin="0,6" Width="480" />
                                                            <TextBlock Text="{Binding Progress.Details}" Style="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="12" />
                                                        </StackPanel>
                                                        <TextBlock Text="{l:T '✓ Всё готово — жмите «Играть!»'}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="16"
                                                                   HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="{Binding Installed, Converter={StaticResource VisibleIf}}" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Тосты. -->
        <ItemsControl ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,8,0,0" MaxWidth="420" Background="#F2111A2E">
                        <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="60" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.4" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Height="34" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="340" VerticalAlignment="Center" FontSize="14" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
