<UserControl x:Class="RibbixLauncher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RibbixLauncher.Core"
             xmlns:v="clr-namespace:RibbixLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
        <v:NotConverter x:Key="Not" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Баннер для Tadpole («реклама» = наш собственный промо-блок, без сторонних сетей). -->
        <Button Grid.Row="0" Style="{StaticResource ImageButton}" Command="{Binding OpenSubscriptionCommand}" Margin="0,0,0,10"
                Visibility="{Binding ShowAdBanner, Converter={StaticResource VisibleIf}}" HorizontalAlignment="Stretch">
            <Border CornerRadius="12" Padding="14,10" BorderThickness="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#3322C55E" Offset="0" />
                        <GradientStop Color="#33F59E0B" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#22C55E" Offset="0" />
                        <GradientStop Color="#F59E0B" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{l:T 'Сравнить тарифы →'}" Foreground="#FDE68A" FontWeight="Bold" VerticalAlignment="Center" />
                    <Image Source="/Assets/ui/frog_king.png" Height="34" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{l:T 'Подписка Ribbix: без рекламы, больше версий, премиум-темы и облачные бэкапы'}" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Игра бесплатна всегда — подписка лишь добавляет удобства лаунчера.'}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Button>

        <!-- Центр: логотип и маскот. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">
                <Image Source="/Assets/main/logo.png" Height="200" HorizontalAlignment="Left" Style="{StaticResource Floating}" />
                <TextBlock Text="{l:T 'Квакнем по-крупному 🐸'}" Style="{StaticResource H2}" Margin="0,12,0,0" />
                <TextBlock Text="{l:T 'Ванилла, Fabric, Quilt, Forge и NeoForge — в один клик.'}" Style="{StaticResource Muted}" />
            </StackPanel>

            <!-- Новый год: ёлка по дням заходов, подарок дня, плейлист. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="380" VerticalAlignment="Center" Margin="0,0,0,10"
                    Visibility="{Binding ShowNewYearPanel, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <Viewbox Height="190" HorizontalAlignment="Center">
                        <Canvas Width="120" Height="160">
                            <Rectangle Canvas.Left="52" Canvas.Top="135" Width="16" Height="20" Fill="#7C2D12" />
                            <Polygon Points="60,70 4,137 116,137" Fill="#15803D" />
                            <Polygon Points="60,40 12,97 108,97" Fill="#16A34A" />
                            <Polygon Points="60,14 20,62 100,62" Fill="#22C55E" />
                            <Ellipse Canvas.Left="40" Canvas.Top="52" Width="9" Height="9" Fill="#EF4444" />
                            <Ellipse Canvas.Left="72" Canvas.Top="80" Width="9" Height="9" Fill="#3B82F6" />
                            <Ellipse Canvas.Left="30" Canvas.Top="112" Width="10" Height="10" Fill="#FACC15" />
                            <Ellipse Canvas.Left="80" Canvas.Top="118" Width="10" Height="10" Fill="#EF4444" />
                            <Ellipse Canvas.Left="55" Canvas.Top="100" Width="9" Height="9" Fill="#EC4899" />
                            <!-- Гирлянда: 5 дней. -->
                            <Canvas Visibility="{Binding HasGarland, Converter={StaticResource VisibleIf}}">
                                <Polyline Points="34,48 60,58 86,46" Stroke="#FACC15" StrokeThickness="1.5" />
                                <Polyline Points="22,84 60,96 98,82" Stroke="#FACC15" StrokeThickness="1.5" />
                                <Polyline Points="12,122 60,134 108,120" Stroke="#FACC15" StrokeThickness="1.5" />
                                <Canvas x:Name="Bulbs">
                                    <Canvas.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.7" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Canvas.Triggers>
                                    <Ellipse Canvas.Left="44" Canvas.Top="51" Width="5" Height="5" Fill="#FDE047" />
                                    <Ellipse Canvas.Left="70" Canvas.Top="51" Width="5" Height="5" Fill="#F87171" />
                                    <Ellipse Canvas.Left="38" Canvas.Top="88" Width="5" Height="5" Fill="#60A5FA" />
                                    <Ellipse Canvas.Left="78" Canvas.Top="88" Width="5" Height="5" Fill="#FDE047" />
                                    <Ellipse Canvas.Left="30" Canvas.Top="126" Width="5" Height="5" Fill="#F87171" />
                                    <Ellipse Canvas.Left="86" Canvas.Top="125" Width="5" Height="5" Fill="#60A5FA" />
                                </Canvas>
                            </Canvas>
                            <!-- Звезда: 10 дней. -->
                            <Polygon Points="60,0 64,10 75,10 66,16 69,27 60,20 51,27 54,16 45,10 56,10" Fill="#FACC15"
                                     Visibility="{Binding HasStar, Converter={StaticResource VisibleIf}}">
                                <Polygon.Effect><DropShadowEffect Color="#FACC15" BlurRadius="14" ShadowDepth="0" /></Polygon.Effect>
                            </Polygon>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="{Binding TreeText}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,10" />
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource AccentButton}" Content="{l:T '🎁 Забрать подарок дня'}" Command="{Binding ClaimGiftCommand}"
                                IsEnabled="{Binding CanClaimGift}" Margin="0,0,8,6" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:T '🎵 Новогодний плейлист'}" Command="{Binding OpenPlaylistCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CouponText}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Foreground="#FDE68A" />
                </StackPanel>
            </Border>

            <!-- Крэш: «Доктор крашей» (причины и починка в один клик), под ним — лог и mclo.gs. -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Width="470" VerticalAlignment="Stretch" Margin="0,0,0,10"
                    BorderBrush="{DynamicResource DangerBrush}" Visibility="{Binding Crash, Converter={StaticResource VisibleIf}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="/Assets/installer/icon_error.png" Height="28" Margin="0,0,10,0" />
                        <TextBlock Style="{StaticResource H2}" VerticalAlignment="Center">
                            <Run Text="{l:T '🩺 Доктор крашей · код '}" /><Run Text="{Binding Crash.ExitCode, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <CheckBox Style="{StaticResource Check}" Content="{l:T 'Показать лог'}" IsChecked="{Binding ShowCrashLog}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Загрузить на mclo.gs'}" Command="{Binding UploadCrashCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource GhostButton}" Content="{l:T 'Копировать'}" Command="{Binding CopyCrashCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource LinkButton}" Content="{Binding MclogsUrl}" Command="{Binding OpenMclogsCommand}" VerticalAlignment="Center"
                                Visibility="{Binding MclogsUrl, Converter={StaticResource VisibleIf}}" />
                    </WrapPanel>
                    <Border DockPanel.Dock="Bottom" Background="#C0050910" CornerRadius="8" Padding="8" MaxHeight="220" Margin="0,10,0,0"
                            Visibility="{Binding ShowCrashLog, Converter={StaticResource VisibleIf}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Crash.LastLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" Foreground="#FCA5A5" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer DataContext="{Binding Doctor}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="{l:T 'Разбираем лог…'}" Style="{StaticResource Muted}"
                                       Visibility="{Binding Diagnoses.Count, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Diagnoses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#33000000" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                <ItemsControl ItemsSource="{Binding Fixes}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Style="{StaticResource AccentButton}" Content="{Binding Label}" Margin="0,4,8,0"
                                                                    Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                                    CommandParameter="{Binding}" IsEnabled="{Binding IsDone, Converter={StaticResource Not}}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}" Margin="0,4,0,8">
                                <TextBlock Text="{Binding Progress.Stage}" Style="{StaticResource Muted}" FontSize="12" />
                                <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Height="6" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Background="#33000000" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                    Visibility="{Binding IsBisecting, Converter={StaticResource VisibleIf}}">
                                <StackPanel>
                                    <TextBlock Text="{l:T '🔎 Ищем мод-виновника'}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding BisectText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <ProgressBar Value="{Binding BisectPercent, Mode=OneWay}" Height="6" Margin="0,8,0,0" />
                                    <TextBlock Text="{l:T 'Игра будет сама запускаться и закрываться — не трогайте её окно. Моды потом вернутся как были.'}"
                                               Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <Button Style="{StaticResource GhostButton}" Content="{l:T 'Остановить'}" Command="{Binding CancelBisectCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Нижняя панель: инстанс, аккаунт, прогресс, Играть/Стоп. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Маскот: весной — на кувшинке, в Новый год — в шапке Санты. -->
                <Grid Grid.Column="0" Margin="0,0,14,0" Style="{StaticResource Floating}">
                    <Grid VerticalAlignment="Bottom" Margin="-8,0,-8,-8" Visibility="{Binding IsSpringTheme, Converter={StaticResource VisibleIf}}">
                        <Ellipse Height="20" Fill="#15803D" />
                        <Ellipse Height="14" Margin="6,2,6,4" Fill="#22C55E" />
                        <Path Data="M0,0 L10,-9 L14,0 Z" Fill="#15803D" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Ellipse Width="9" Height="9" Fill="#F9A8D4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,-2,0,0" />
                    </Grid>
                    <Image Source="{Binding Mascot}" Height="62" />
                    <Canvas Width="40" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,-16,0,0"
                            Visibility="{Binding IsNewYearTheme, Converter={StaticResource VisibleIf}}" IsHitTestVisible="False">
                        <Canvas.RenderTransform><RotateTransform Angle="18" CenterX="20" CenterY="20" /></Canvas.RenderTransform>
                        <Path Data="M4,24 L22,2 L36,24 Z" Fill="#DC2626" />
                        <Rectangle Canvas.Left="1" Canvas.Top="21" Width="38" Height="7" RadiusX="3" RadiusY="3" Fill="#F8FAFC" />
                        <Ellipse Canvas.Left="17" Canvas.Top="-3" Width="9" Height="9" Fill="#F8FAFC" />
                    </Canvas>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{l:T 'Версия'}" Style="{StaticResource Muted}" />
                    <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" Margin="0,4,0,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/main/icon_version.png" Height="20" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DisplayVersion}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{Binding AccountLabel}" Style="{StaticResource Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0"
                            Visibility="{Binding Progress.IsActive, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Source="/Assets/main/loader.png" Height="22" Margin="0,0,8,0" Style="{StaticResource Spinning}" />
                        <TextBlock Text="{Binding Progress.Stage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding Progress.Percent, Mode=OneWay}" IsIndeterminate="{Binding Progress.IsIndeterminate}" Margin="0,6" />
                    <TextBlock Text="{Binding Progress.Details}" Style="{StaticResource Muted}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleIf}}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/ui/status_online.png" Height="24" />
                        <TextBlock Text="{l:T '  Игра запущена — приятной игры!'}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastLogLine}" Style="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerButton}" Content="{l:T '■  Стоп'}" Command="{Binding StopCommand}" Margin="0,0,12,0" Height="44"
                            Visibility="{Binding ShowStop, Converter={StaticResource VisibleIf}}" />
                    <Button x:Name="PlayButton" Style="{StaticResource ImageButton}" Command="{Binding PlayCommand}" ToolTip="{l:T 'Играть'}">
                        <Grid>
                            <v:ArtLabel x:Name="PlayIdle" Source="/Assets/main/btn_play.png" Height="78" Label="Играть" LabelColor="#97E74C" LabelArea="0.39,0.36,0.48,0.36" />
                            <!-- Подсвеченная картинка есть только с русской подписью; на других языках — свечение. -->
                            <Grid Visibility="{x:Static l:L.RussianVisibility}">
                                <Image Source="/Assets/main/btn_play_hover.png" Height="78"
                                       Visibility="{Binding IsMouseOver, ElementName=PlayButton, Converter={StaticResource VisibleIf}}" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
