<UserControl x:Class="RibbixLauncher.Views.SubscriptionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RibbixLauncher.Core"
             xmlns:v="clr-namespace:RibbixLauncher.Views"
             Style="{StaticResource Page}">
    <UserControl.Resources>
        <v:VisibleIfConverter x:Key="VisibleIf" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <!-- Pull-to-refresh: прокрутка вверх у верхнего края (см. code-behind). -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scroller_PreviewMouseWheel">
        <StackPanel>
            <!-- Индикатор обновления. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8"
                        Visibility="{Binding IsRefreshing, Converter={StaticResource VisibleIf}}">
                <Image Source="/Assets/ui/loader.png" Height="22" Style="{StaticResource Spinning}" />
                <TextBlock Text="{l:T '  Обновляем статус подписки…'}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="PullHint" Text="{l:T '↓ Отпустите, чтобы обновить'}" HorizontalAlignment="Center" Style="{StaticResource Muted}"
                       Visibility="Collapsed" Margin="0,0,0,6" />

            <!-- Текущий тариф. -->
            <v:PixelBorder Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="{l:T '⟳ Обновить'}" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource AccentButton}" Content="{l:T 'Управлять'}" Command="{Binding ManageCommand}"
                                Visibility="{Binding CanManage, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                    <Image Source="/Assets/ui/frog_king.png" Height="54" Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T 'Ваш тариф: '}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding CurrentTierName}" Style="{StaticResource H2}" Foreground="{Binding CurrentTierBrush}" />
                            <Border Style="{StaticResource AdminBadge}" Margin="10,0,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource VisibleIf}}">
                                <TextBlock Text="ADMIN" FontWeight="Black" FontSize="11" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource Muted}" />
                        <TextBlock Style="{StaticResource Muted}" Foreground="{DynamicResource WarnBrush}"
                                   Visibility="{Binding IsLoggedIn, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"
                                   Text="{Binding SignInHint}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </v:PixelBorder>

            <!-- Grace. -->
            <v:PixelBorder CornerRadius="12" Padding="14,10" Margin="0,10,0,0" Background="#33F59E0B" BorderBrush="{DynamicResource WarnBrush}" BorderThickness="1"
                    Visibility="{Binding GraceBanner, Converter={StaticResource VisibleIf}}">
                <StackPanel Orientation="Horizontal">
                    <v:PixelIcon Kind="warning" Foreground="{DynamicResource WarnBrush}" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding GraceBanner}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </v:PixelBorder>

            <v:PixelBorder CornerRadius="12" Padding="14,8" Margin="0,10,0,0" Background="#223B82F6" BorderBrush="#3B82F6" BorderThickness="1"
                    Visibility="{Binding VerificationFailed, Converter={StaticResource VisibleIf}}">
                <TextBlock Text="{l:T 'Не удалось проверить подписку. Работаем по сохранённым данным, пока сервер недоступен.'}" />
            </v:PixelBorder>

            <!-- Управление: отмена автопродления и история. -->
            <v:PixelBorder Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding ShowManage, Converter={StaticResource VisibleIf}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="{l:T 'Отключить автопродление'}"
                                Command="{Binding CancelAutoRenewCommand}" Visibility="{Binding CanCancel, Converter={StaticResource VisibleIf}}" />
                        <TextBlock Text="{l:T 'История платежей'}" Style="{StaticResource H2}" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding History}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Style="{StaticResource Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding TierSlug}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat={}{0:0.##} ₽}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource Muted}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </v:PixelBorder>

            <!-- Блок покупки. Для Admin скрыт целиком. -->
            <StackPanel Margin="0,16,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                <DockPanel Margin="0,0,0,12">
                    <v:PixelBorder DockPanel.Dock="Right" Background="#140A101E" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="period" Content="{l:T 'Месяц'}" IsChecked="True" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="period" IsChecked="{Binding IsYearly}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T 'Год'}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <v:PixelBorder Background="#F59E0B" CornerRadius="5" Padding="5,0" Margin="6,0,0,0">
                                        <TextBlock Text="-17%" FontSize="11" FontWeight="Bold" Foreground="#1F1302" />
                                    </v:PixelBorder>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </v:PixelBorder>
                    <TextBlock Text="{l:T 'Тарифы Ribbix'}" Style="{StaticResource H1}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Покупка через тикет в Discord. -->
                <v:PixelBorder CornerRadius="12" Padding="14,10" Margin="0,0,0,12" Background="#225865F2" BorderBrush="#5865F2" BorderThickness="1"
                        Visibility="{Binding DiscordPurchase, Converter={StaticResource VisibleIf}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="{l:T 'Открыть Discord'}" Command="{Binding OpenDiscordCommand}"
                                VerticalAlignment="Center" BorderBrush="#5865F2" />
                        <ContentControl Style="{StaticResource IconTile}" Tag="chat" Foreground="#8B9BFF" Width="40" Height="40" FontSize="24" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{l:T 'Покупка — через тикет в нашем Discord'}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                                       Text="{l:T 'Нажмите «Оформить»: заказ скопируется, откроется сервер. Создайте тикет и вставьте заказ — после оплаты вам выдадут роль, нажмите «⟳ Обновить».'}" />
                        </StackPanel>
                    </DockPanel>
                </v:PixelBorder>

                <!-- Акция по расписанию. -->
                <v:PixelBorder CornerRadius="12" Padding="14,10" Margin="0,0,0,12" Background="#22F59E0B" BorderBrush="#F59E0B" BorderThickness="1"
                        Visibility="{Binding EventBanner, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="{Binding EventBanner}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </v:PixelBorder>

                <!-- Промокод. -->
                <StackPanel Margin="0,0,0,12">
                    <Button Style="{StaticResource LinkButton}" Content="{l:T '🎟 Есть промокод?'}" HorizontalAlignment="Left" Command="{Binding TogglePromoCommand}"
                            Visibility="{Binding ShowPromoBox, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPromoBox, Converter={StaticResource VisibleIf}}">
                        <TextBox Width="220" Text="{Binding PromoInput, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                                 AutomationProperties.Name="Промокод">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding ApplyPromoCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource AccentButton}" Content="{l:T 'Применить'}" Margin="8,0,0,0" Command="{Binding ApplyPromoCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="✕" Margin="6,0,0,0" Padding="10,4" Command="{Binding ClearPromoCommand}"
                                ToolTip="{l:T 'Убрать промокод'}" Visibility="{Binding AppliedCode, Converter={StaticResource VisibleIf}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PromoMessage}" Margin="0,6,0,0" FontSize="12"
                               Visibility="{Binding PromoMessage, Converter={StaticResource VisibleIf}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PromoError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{Binding Error}" Style="{StaticResource Muted}" Foreground="{DynamicResource WarnBrush}"
                           Visibility="{Binding Error, Converter={StaticResource VisibleIf}}" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding Tiers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,14,6,0">
                                <!-- Свечение для рекомендуемого тарифа (Ribbix+). -->
                                <v:PixelBorder x:Name="Glow" CornerRadius="16" Background="{Binding Brush}" Opacity="0" Margin="-2">
                                    <Border.Effect><BlurEffect Radius="22" /></Border.Effect>
                                </v:PixelBorder>
                                <v:PixelBorder CornerRadius="16" BorderThickness="2" BorderBrush="{Binding Brush}" Background="#EE0D1528" Padding="14,18,14,14">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top">
                                            <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold" Foreground="{Binding Brush}" />
                                            <v:PixelBorder HorizontalAlignment="Left" CornerRadius="6" Padding="6,1" Margin="0,6,0,0" Background="#F59E0B"
                                                    Visibility="{Binding HasDiscount, Converter={StaticResource VisibleIf}}">
                                                <TextBlock Text="{Binding DiscountBadge}" FontSize="11" FontWeight="Bold" Foreground="#1F1302" TextTrimming="CharacterEllipsis" />
                                            </v:PixelBorder>
                                            <TextBlock Margin="0,8,0,0">
                                                <Run Text="{Binding OldPriceText, Mode=OneWay}" FontSize="14" TextDecorations="Strikethrough" Foreground="{DynamicResource MutedBrush}" />
                                                <Run Text="{Binding PriceText, Mode=OneWay}" FontSize="24" FontWeight="Black" />
                                                <Run Text="{Binding PeriodText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding YearHint}" FontSize="11" Foreground="#FBBF24" TextWrapping="Wrap"
                                                       Visibility="{Binding YearHint, Converter={StaticResource VisibleIf}}" />
                                        </StackPanel>

                                        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                            <Button Content="{l:T 'Оформить'}" Style="{StaticResource AccentButton}" Background="{Binding Brush}"
                                                    Command="{Binding DataContext.CheckoutCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Visibility="{Binding CanBuy, Converter={StaticResource VisibleIf}}" />
                                            <v:PixelBorder CornerRadius="10" Padding="0,9" Background="#22FFFFFF"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource VisibleIf}}">
                                                <TextBlock Text="{l:T '✓ Текущий'}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                            </v:PixelBorder>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Features}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                                        <TextBlock Text="✓ " Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="150" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </v:PixelBorder>
                                <v:PixelBorder x:Name="Ribbon" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-12,0,0"
                                        Background="{Binding Brush}" CornerRadius="8" Padding="10,3">
                                    <TextBlock Text="{l:T '★ Популярный'}" FontSize="11" FontWeight="Bold" Foreground="#1F1302" />
                                </v:PixelBorder>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter TargetName="Ribbon" Property="Visibility" Value="Visible" />
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity"
                                                                 From="0.25" To="0.7" Duration="0:0:1.4" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Юридическое. -->
            <v:PixelBorder Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}"
                               Text="{l:T 'Подписка даёт доступ к функциям Ribbix и не связана с Mojang/Microsoft. Minecraft — товарный знак Mojang AB. Ribbix — неофициальный лаунчер; доступ к игре не продаётся, играть можно на любом тарифе.'}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="{l:T 'Публичная оферта'}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding OfferUrl}" Margin="0,0,16,0" />
                        <Button Style="{StaticResource LinkButton}" Content="{l:T 'Политика возврата'}" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding RefundUrl}" />
                    </StackPanel>
                </StackPanel>
            </v:PixelBorder>
        </StackPanel>
    </ScrollViewer>
</UserControl>
