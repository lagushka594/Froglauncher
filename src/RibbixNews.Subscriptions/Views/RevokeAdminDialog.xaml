<Window x:Class="RibbixNews.Subscriptions.Views.RevokeAdminDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Снятие" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#0F172A" FontFamily="Segoe UI" FontSize="14"
        FocusManager.FocusedElement="{Binding ElementName=ReasonBox}">
    <Window.Resources>
        <ResourceDictionary Source="pack://application:,,,/RibbixNews.Subscriptions;component/Views/Styles.xaml" />
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Foreground="White" FontSize="18" FontWeight="Bold" Text="{Binding Title}" TextWrapping="Wrap" />
        <TextBlock Foreground="#FCA5A5" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Warning}" />
        <TextBlock Text="Причина (обязательно, от 5 символов)" Foreground="#94A3B8" Margin="0,14,0,4" />
        <TextBox x:Name="ReasonBox" Style="{StaticResource FnInput}" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" Height="70" MaxLength="500" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource FnGhost}" Content="Отмена" IsCancel="True" Margin="0,0,8,0" />
            <Button Style="{StaticResource FnDangerButton}" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" Click="Confirm_Click" />
        </StackPanel>
    </StackPanel>
</Window>
