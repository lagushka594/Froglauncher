<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Самодостаточные стили модуля: не зависят от темы RibbixNews. -->
    <SolidColorBrush x:Key="FnBg" Color="#0F172A" />
    <SolidColorBrush x:Key="FnPanel" Color="#111C33" />
    <SolidColorBrush x:Key="FnLine" Color="#24314F" />
    <SolidColorBrush x:Key="FnText" Color="#E2E8F0" />
    <SolidColorBrush x:Key="FnMuted" Color="#94A3B8" />
    <SolidColorBrush x:Key="FnAccent" Color="#22C55E" />
    <SolidColorBrush x:Key="FnAdmin" Color="#7C3AED" />
    <SolidColorBrush x:Key="FnDanger" Color="#EF4444" />

    <Style x:Key="FnButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#22C55E" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.35" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FnGhost" TargetType="Button" BasedOn="{StaticResource FnButton}">
        <Setter Property="Background" Value="#1E293B" />
    </Style>
    <Style x:Key="FnAdminButton" TargetType="Button" BasedOn="{StaticResource FnButton}">
        <Setter Property="Background" Value="#7C3AED" />
    </Style>
    <Style x:Key="FnDangerButton" TargetType="Button" BasedOn="{StaticResource FnButton}">
        <Setter Property="Background" Value="#DC2626" />
    </Style>

    <Style x:Key="FnInput" TargetType="TextBox">
        <Setter Property="Background" Value="#0B1220" />
        <Setter Property="Foreground" Value="{StaticResource FnText}" />
        <Setter Property="BorderBrush" Value="{StaticResource FnLine}" />
        <Setter Property="CaretBrush" Value="{StaticResource FnAccent}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="FnAdminBadge" TargetType="Border">
        <Setter Property="Background" Value="#7C3AED" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="FnGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource FnText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="#0F1A30" />
        <Setter Property="AlternatingRowBackground" Value="#13203A" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="RowHeight" Value="34" />
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="Foreground" Value="{StaticResource FnMuted}" />
                    <Setter Property="Padding" Value="10,8" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="10,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3322C55E" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
